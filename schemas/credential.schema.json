{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seallink.org/releases/v1.0.0-draft.9/schemas/credential.schema.json",
  "title": "SealLink v1.0 Verifiable Credentials & General Notary Acts",
  "$defs": {
    "Credential": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "signatures"],
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "network", "genesis", "credential_kind", "issuer", "subject", "claims", "lifecycle", "not_before_height", "issued_at"],
          "properties": {
            "type": { "const": "seallink-credential/1" },
            "network": { "$ref": "common.schema.json#/$defs/Network" },
            "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
            "credential_kind": { "type": "string", "pattern": "^[a-z0-9._-]+(/[a-z0-9._-]+)*$", "maxLength": 128, "not": { "pattern": "\n" } },
            "issuer": { "$ref": "common.schema.json#/$defs/RoleIssuerPin" },
            "subject": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mode", "key"],
                  "properties": {
                    "mode": { "const": "key" },
                    "key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mode", "name_pin"],
                  "properties": {
                    "mode": { "const": "name" },
                    "name_pin": { "$ref": "common.schema.json#/$defs/NamePin" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["mode", "origin_id"],
                  "properties": {
                    "mode": { "const": "origin" },
                    "origin_id": { "$ref": "common.schema.json#/$defs/Hex64" }
                  }
                }
              ]
            },
            "claims": {
              "type": "object",
              "maxProperties": 64,
              "additionalProperties": {
                "oneOf": [
                  { "type": "string", "maxLength": 1024, "not": { "pattern": "\n" } },
                  { "type": "boolean" },
                  { "$ref": "common.schema.json#/$defs/Uint53" }
                ]
              },
              "description": "Typed scalar claims constrained further by credential_kind profile."
            },
            "claim_commitments": {
              "type": "object",
              "maxProperties": 64,
              "additionalProperties": { "$ref": "common.schema.json#/$defs/Hex64" },
              "description": "Optional per-claim salted hashes H_tag('seallink-clause/1', salt_32B || JCS(claim_obj)) using an independent 32-byte CSPRNG salt per claim."
            },
            "lifecycle": { "type": "string", "enum": ["eternal", "revocable"] },
            "revocation_seal": { "$ref": "common.schema.json#/$defs/Seal" },
            "not_before_height": { "$ref": "common.schema.json#/$defs/Uint53" },
            "not_after_height": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
            "not_after_unix": { "$ref": "common.schema.json#/$defs/Uint53" },
            "issued_at": { "$ref": "common.schema.json#/$defs/Uint53" }
          },
          "allOf": [
            {
              "if": { "required": ["lifecycle"], "properties": { "lifecycle": { "const": "revocable" } } },
              "then": { "required": ["revocation_seal"] }
            },
            {
              "if": { "required": ["lifecycle"], "properties": { "lifecycle": { "const": "eternal" } } },
              "then": { "not": { "required": ["revocation_seal"] } }
            }
          ]
        },
        "signatures": { "$ref": "common.schema.json#/$defs/SignatureSet" }
      }
    },
    "CredentialWithdrawal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "genesis", "credential_id", "cause_sha256"],
      "properties": {
        "type": { "const": "seallink-credential-withdrawal/1" },
        "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
        "credential_id": { "$ref": "common.schema.json#/$defs/Hex64" },
        "cause_sha256": { "$ref": "common.schema.json#/$defs/Hex64" }
      }
    },
    "CredentialBreak": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "genesis", "issuer", "role", "compromised_policy", "name_input", "h_c"],
      "properties": {
        "type": { "const": "seallink-credential-break/1" },
        "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
        "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
        "role": { "type": "string", "enum": ["cred", "notary", "grant"] },
        "compromised_policy": { "$ref": "common.schema.json#/$defs/ThresholdPolicy" },
        "name_input": { "$ref": "common.schema.json#/$defs/Outpoint" },
        "h_c": { "$ref": "common.schema.json#/$defs/Uint53" }
      }
    },
    "NotaryAct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "signatures"],
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "network", "genesis", "act_kind", "notary", "lifecycle", "target_sha256", "details", "tip_height", "tip_hash", "attested_at"],
          "properties": {
            "type": { "const": "seallink-notary/1" },
            "network": { "$ref": "common.schema.json#/$defs/Network" },
            "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
            "act_kind": { "type": "string", "enum": ["contract-notarization", "certified-copy", "fact-attestation", "child-within-parent"] },
            "notary": { "$ref": "common.schema.json#/$defs/RoleIssuerPin" },
            "lifecycle": { "type": "string", "enum": ["eternal", "revocable"] },
            "notary_seal": { "$ref": "common.schema.json#/$defs/Seal" },
            "target_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
            "details": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "contract_id"],
                  "properties": {
                    "kind": { "const": "contract-notarization" },
                    "contract_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "notary_clause_sha256": { "$ref": "common.schema.json#/$defs/Hex64" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "original_sha256", "media_type"],
                  "properties": {
                    "kind": { "const": "certified-copy" },
                    "original_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "media_type": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "fact_schema", "fact_sha256"],
                  "properties": {
                    "kind": { "const": "fact-attestation" },
                    "fact_schema": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } },
                    "fact_sha256": { "$ref": "common.schema.json#/$defs/Hex64" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "parent_grant_id", "child_grant_id", "ordinal"],
                  "properties": {
                    "kind": { "const": "child-within-parent" },
                    "parent_grant_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "child_grant_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "ordinal": { "$ref": "common.schema.json#/$defs/PositiveUint53" }
                  }
                }
              ]
            },
            "tip_height": { "$ref": "common.schema.json#/$defs/Uint53" },
            "tip_hash": { "$ref": "common.schema.json#/$defs/Hex64" },
            "attested_at": { "$ref": "common.schema.json#/$defs/Uint53" }
          },
          "allOf": [
            {
              "if": { "required": ["lifecycle"], "properties": { "lifecycle": { "const": "revocable" } } },
              "then": { "required": ["notary_seal"] }
            },
            {
              "if": { "required": ["lifecycle"], "properties": { "lifecycle": { "const": "eternal" } } },
              "then": { "not": { "required": ["notary_seal"] } }
            },
            {
              "if": { "required": ["act_kind"], "properties": { "act_kind": { "const": "contract-notarization" } } },
              "then": { "properties": { "details": { "properties": { "kind": { "const": "contract-notarization" } } } } }
            },
            {
              "if": { "required": ["act_kind"], "properties": { "act_kind": { "const": "certified-copy" } } },
              "then": { "properties": { "details": { "properties": { "kind": { "const": "certified-copy" } } } } }
            },
            {
              "if": { "required": ["act_kind"], "properties": { "act_kind": { "const": "fact-attestation" } } },
              "then": { "properties": { "details": { "properties": { "kind": { "const": "fact-attestation" } } } } }
            },
            {
              "if": { "required": ["act_kind"], "properties": { "act_kind": { "const": "child-within-parent" } } },
              "then": { "properties": { "details": { "properties": { "kind": { "const": "child-within-parent" } } } } }
            }
          ]
        },
        "signatures": { "$ref": "common.schema.json#/$defs/SignatureSet" }
      }
    }
  }
}
