{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seallink.org/releases/v1.0.0-draft.11/schemas/grant.schema.json",
  "title": "SealLink v1.0 Universal Grant & Issuance Preparation",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "signatures"],
      "properties": {
        "payload": {
          "allOf": [
            { "$ref": "#/$defs/GrantPayload" },
            { "not": { "required": ["guardian_context"] } },
            {
              "if": { "required": ["issuer"] },
              "then": { "properties": { "issuer": { "required": ["role_policy"] } } }
            }
          ]
        },
        "signatures": { "$ref": "common.schema.json#/$defs/SignatureSet" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "guardian_approvals"],
      "properties": {
        "payload": {
          "allOf": [
            { "$ref": "#/$defs/GrantPayload" },
            { "required": ["issuer", "guardian_context"] },
            { "not": { "required": ["parent"] } },
            { "properties": { "issuer": { "not": { "required": ["role_policy"] } } } }
          ]
        },
        "guardian_approvals": { "$ref": "common.schema.json#/$defs/GuardianApprovals" }
      }
    }
  ],
  "$defs": {
    "GrantIssuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "registration", "owner_policy"],
      "properties": {
        "name": { "$ref": "common.schema.json#/$defs/NameStr" },
        "registration": { "$ref": "common.schema.json#/$defs/Outpoint" },
        "owner_policy": { "$ref": "common.schema.json#/$defs/ScriptPolicy" },
        "role_policy": { "$ref": "common.schema.json#/$defs/ThresholdPolicy" }
      }
    },
    "GrantPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "network", "genesis", "recipient", "capabilities", "not_before_height", "not_after_height", "recent_block", "revocation"],
      "properties": {
        "type": { "const": "seallink-grant/1" },
        "network": { "$ref": "common.schema.json#/$defs/Network" },
        "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
        "issuer": { "$ref": "#/$defs/GrantIssuer" },
        "parent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["grant_id", "ordinal"],
          "properties": {
            "grant_id": { "$ref": "common.schema.json#/$defs/Hex64" },
            "ordinal": { "$ref": "common.schema.json#/$defs/PositiveUint53" }
          }
        },
        "contract_id": { "$ref": "common.schema.json#/$defs/Hex64" },
        "recipient": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "key"],
              "properties": {
                "mode": { "const": "key" },
                "key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "name", "registration", "owner_policy"],
              "properties": {
                "mode": { "const": "name" },
                "name": { "$ref": "common.schema.json#/$defs/NameStr" },
                "registration": { "$ref": "common.schema.json#/$defs/Outpoint" },
                "owner_policy": { "$ref": "common.schema.json#/$defs/ScriptPolicy" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "threshold"],
              "properties": {
                "mode": { "const": "group" },
                "threshold": { "$ref": "common.schema.json#/$defs/ThresholdPolicy" }
              }
            }
          ]
        },
        "executor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "key"],
          "properties": {
            "name": { "$ref": "common.schema.json#/$defs/NameStr" },
            "key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" }
          }
        },
        "executor_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider_of", "service_type", "label"],
          "properties": {
            "provider_of": { "$ref": "common.schema.json#/$defs/NameStr" },
            "service_type": { "$ref": "common.schema.json#/$defs/ServiceTypeStr" },
            "label": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "not": { "pattern": "\n" } }
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "common.schema.json#/$defs/Capability" }
        },
        "terms_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "x-seallink-allow-lf": true,
          "description": "Cognitive work guidance ONLY; mechanical effect executors MUST refuse any grant carrying terms_text."
        },
        "not_before_height": { "$ref": "common.schema.json#/$defs/Uint53" },
        "not_after_height": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
        "recent_block": { "$ref": "common.schema.json#/$defs/Hex64" },
        "min_depth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 144,
          "x-seallink-refusal": "WIRE_INTEGER",
          "description": "Optional issuer-requested minimum confirmation depth for anchor/seal (omitted defaults to 1)."
        },
        "revocation": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "construction", "kind", "seal"],
              "properties": {
                "mode": { "const": "seal" },
                "construction": { "type": "string", "enum": ["W", "L"] },
                "kind": { "const": "revocable" },
                "seal": { "$ref": "common.schema.json#/$defs/Seal" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "construction", "kind", "seal"],
              "properties": {
                "mode": { "const": "seal" },
                "construction": { "type": "string", "enum": ["W", "L"] },
                "kind": { "const": "single_use" },
                "seal": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["txid", "vout", "script_policy"],
                  "properties": {
                    "txid": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "vout": { "$ref": "common.schema.json#/$defs/Vout" },
                    "script_policy": { "$ref": "common.schema.json#/$defs/SingleUseScriptPolicy" }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": {
                "mode": { "const": "window_only" }
              },
              "description": "Root-only zero-tx ephemeral mode (not_after - not_before <= 12 blocks); refused by default unless executor policy permits."
            }
          ]
        },
        "delegate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "child_seal_key", "pools", "groups"],
          "properties": {
            "key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" },
            "child_seal_key": { "$ref": "common.schema.json#/$defs/CompressedPubkey66" },
            "pools": {
              "type": "array",
              "maxItems": 32,
              "items": { "$ref": "common.schema.json#/$defs/Quota" }
            },
            "notaries": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": { "$ref": "common.schema.json#/$defs/NamePin" }
            },
            "groups": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["template", "ranges"],
                "properties": {
                  "template": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["executor", "recipient_rule", "capabilities", "notary_mode"],
                    "properties": {
                      "executor": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "key"],
                        "properties": {
                          "name": { "$ref": "common.schema.json#/$defs/NameStr" },
                          "key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" }
                        }
                      },
                      "recipient_rule": { "$ref": "#/$defs/RecipientRule" },
                      "capabilities": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 64,
                        "items": { "$ref": "common.schema.json#/$defs/Capability" }
                      },
                      "notary_mode": { "type": "string", "enum": ["none", "optional_stop", "required_act"] },
                      "notary_name": { "$ref": "common.schema.json#/$defs/NameStr" }
                    },
                    "allOf": [
                      {
                        "if": { "required": ["notary_mode"], "properties": { "notary_mode": { "enum": ["optional_stop", "required_act"] } } },
                        "then": { "required": ["notary_name"] }
                      },
                      {
                        "if": { "required": ["notary_mode"], "properties": { "notary_mode": { "const": "none" } } },
                        "then": { "not": { "required": ["notary_name"] } }
                      }
                    ]
                  },
                  "ranges": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 16,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["txid", "first", "count", "script_policy"],
                      "properties": {
                        "txid": { "$ref": "common.schema.json#/$defs/Hex64" },
                        "first": { "$ref": "common.schema.json#/$defs/Vout" },
                        "count": { "type": "integer", "minimum": 1, "maximum": 2048, "x-seallink-refusal": "WIRE_INTEGER" },
                        "script_policy": { "$ref": "common.schema.json#/$defs/P2wpkhScriptPolicy" },
                        "stop_txid": { "$ref": "common.schema.json#/$defs/Hex64" },
                        "stop_first": { "$ref": "common.schema.json#/$defs/Vout" },
                        "stop_script_policy": { "$ref": "common.schema.json#/$defs/P2wpkhScriptPolicy" }
                      },
                      "dependentRequired": {
                        "stop_txid": ["stop_first", "stop_script_policy"],
                        "stop_first": ["stop_txid", "stop_script_policy"],
                        "stop_script_policy": ["stop_txid", "stop_first"]
                      }
                    }
                  }
                },
                "if": {
                  "required": ["template"],
                  "properties": {
                    "template": {
                      "required": ["notary_mode"],
                      "properties": { "notary_mode": { "const": "optional_stop" } }
                    }
                  }
                },
                "then": {
                  "properties": {
                    "ranges": {
                      "items": { "required": ["stop_txid", "stop_first", "stop_script_policy"] }
                    }
                  }
                }
              }
            }
          },
          "if": {
            "required": ["groups"],
            "properties": {
              "groups": {
                "contains": {
                  "required": ["template"],
                  "properties": {
                    "template": {
                      "required": ["notary_mode"],
                      "properties": { "notary_mode": { "enum": ["optional_stop", "required_act"] } }
                    }
                  }
                }
              }
            }
          },
          "then": { "required": ["notaries"] }
        },
        "guardian_context": { "$ref": "common.schema.json#/$defs/GuardianContext" }
      },
      "allOf": [
        {
          "oneOf": [
            { "required": ["issuer"], "not": { "required": ["parent"] } },
            { "required": ["parent"], "not": { "required": ["issuer"] } }
          ]
        },
        {
          "oneOf": [
            { "required": ["executor"], "not": { "required": ["executor_ref"] } },
            { "required": ["executor_ref"], "not": { "required": ["executor"] } }
          ]
        },
        {
          "if": { "required": ["parent"] },
          "then": {
            "not": { "required": ["delegate"] },
            "properties": {
              "revocation": {
                "properties": {
                  "mode": { "const": "seal" },
                  "seal": {
                    "properties": {
                      "script_policy": {
                        "oneOf": [
                          { "$ref": "common.schema.json#/$defs/P2wpkhScriptPolicy" },
                          { "$ref": "common.schema.json#/$defs/SingleUseScriptPolicy" }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["revocation"],
            "properties": { "revocation": { "properties": { "mode": { "const": "window_only" } }, "required": ["mode"] } }
          },
          "then": {
            "not": { "anyOf": [{ "required": ["delegate"] }, { "required": ["parent"] }] }
          }
        },
        {
          "if": { "required": ["executor_ref"] },
          "then": {
            "not": { "required": ["delegate"] },
            "properties": {
              "revocation": {
                "not": { "properties": { "kind": { "const": "single_use" } }, "required": ["kind"] }
              },
              "capabilities": {
                "items": { "not": { "required": ["quotas"] } }
              }
            }
          }
        }
      ]
    },
    "RecipientRule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "key"],
          "properties": {
            "mode": { "const": "exact_key" },
            "key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "name", "registration", "owner_policy"],
          "properties": {
            "mode": { "const": "exact_name" },
            "name": { "$ref": "common.schema.json#/$defs/NameStr" },
            "registration": { "$ref": "common.schema.json#/$defs/Outpoint" },
            "owner_policy": { "$ref": "common.schema.json#/$defs/ScriptPolicy" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "operators"],
          "properties": {
            "mode": { "const": "member_class" },
            "operators": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": { "$ref": "common.schema.json#/$defs/NamePin" }
            }
          }
        }
      ]
    },
    "IssuancePrep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "genesis", "grant_id", "grant_content_addr"],
      "description": "Unique canonical preimage for OP_RETURN 0x01 (and 0x02 root batch leaves). contract_id MUST be included iff grant.payload carries contract_id.",
      "properties": {
        "type": { "const": "seallink-issuance/1" },
        "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
        "grant_id": { "$ref": "common.schema.json#/$defs/Hex64" },
        "grant_content_addr": { "$ref": "common.schema.json#/$defs/Hex64" },
        "contract_id": { "$ref": "common.schema.json#/$defs/Hex64" }
      }
    }
  }
}
