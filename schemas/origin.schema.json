{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seallink.org/schemas/v1/origin.schema.json",
  "title": "SealLink v1.0 Origin Certificate (Birth, Materialization, Incorporation)",
  "type": "object",
  "additionalProperties": false,
  "required": ["payload", "signatures"],
  "properties": {
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "network", "genesis", "origin_class", "issuer", "request_sha256",
        "subject_initial_key", "binding_seal", "status_seal", "claims_salt", "claims", "name_recovery"
      ],
      "properties": {
        "type": { "const": "seallink-origin/1" },
        "network": { "$ref": "common.schema.json#/$defs/Network" },
        "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
        "origin_class": { "type": "string", "enum": ["person", "agent", "organization"] },
        "issuer": { "$ref": "common.schema.json#/$defs/RoleIssuerPin" },
        "request_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
        "subject_initial_key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" },
        "binding_seal": { "$ref": "common.schema.json#/$defs/Seal" },
        "status_seal": {
          "$ref": "common.schema.json#/$defs/Seal",
          "description": "Authenticated status spine UTXO; while unspent, proves neither seallink-capacity/1 nor seallink-end/1 has occurred."
        },
        "claims_salt": { "$ref": "common.schema.json#/$defs/Hex64" },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": ["intended_name", "intended_owner_policy"],
          "properties": {
            "intended_name": { "$ref": "common.schema.json#/$defs/NameStr" },
            "intended_owner_policy": { "$ref": "common.schema.json#/$defs/ScriptPolicy" },
            "majority_commitment": {
              "$ref": "common.schema.json#/$defs/Hex64",
              "description": "Salted selective-disclosure commitment H_tag('seallink-clause/1', salt || JCS({majority_unix: T})); keeps birthday/majority date private."
            },
            "config_sha256": { "$ref": "common.schema.json#/$defs/Hex64" }
          }
        },
        "guardian_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision", "revision_size", "disposer", "arbiter", "roster_seal", "appointment_delay_blocks", "quorums", "slots"],
          "properties": {
            "revision": { "const": 1 },
            "revision_size": { "type": "integer", "minimum": 1, "maximum": 32 },
            "disposer": { "$ref": "common.schema.json#/$defs/ScriptPolicy" },
            "arbiter": { "$ref": "common.schema.json#/$defs/ScriptPolicy" },
            "roster_seal": {
              "$ref": "common.schema.json#/$defs/Seal",
              "description": "both_of_2(disposer, arbiter) seal spent with action 0x0f to advance guardianship revision."
            },
            "appointment_delay_blocks": { "type": "integer", "minimum": 1, "maximum": 52560 },
            "quorums": { "$ref": "common.schema.json#/$defs/QuorumMap" },
            "slots": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["slot", "initial_guardian_commitment", "vacant_utxo"],
                "properties": {
                  "slot": { "type": "integer", "minimum": 1, "maximum": 32 },
                  "initial_guardian_commitment": {
                    "$ref": "common.schema.json#/$defs/Hex64",
                    "description": "Salted selective-disclosure commitment H_tag('seallink-clause/1', salt_i || JCS(initial_guardian_NamePin)); protects initial guardian identity privacy."
                  },
                  "vacant_utxo": { "$ref": "common.schema.json#/$defs/Outpoint" }
                }
              }
            }
          }
        },
        "capacity_authority": { "$ref": "common.schema.json#/$defs/NamePin" },
        "name_recovery": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": { "mode": { "const": "none" } }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "disposer", "arbiter", "delay_blocks", "recovery_seal"],
              "properties": {
                "mode": { "const": "dual_party_delayed" },
                "disposer": { "$ref": "common.schema.json#/$defs/ScriptPolicy" },
                "arbiter": { "$ref": "common.schema.json#/$defs/ScriptPolicy" },
                "delay_blocks": { "type": "integer", "minimum": 144, "maximum": 52560 },
                "recovery_seal": { "$ref": "common.schema.json#/$defs/Seal" }
              }
            }
          ]
        }
      }
    },
    "signatures": { "$ref": "common.schema.json#/$defs/SignatureSet" }
  }
}
