{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seallink.org/releases/v1.0.0-draft.11/schemas/common.schema.json",
  "title": "SealLink v1.0 Shared Wire Primitives",
  "description": "Shared primitives with normative x-seallink-refusal class annotations (SPEC-01 §7 deterministic leaf-wins precedence: WIRE_TYPE -> WIRE_MEMBER -> WIRE_INTEGER -> WIRE_KEY -> WIRE_SIGNATURE -> WIRE_CONSTRAINT -> CHAIN_SCRIPT_UNSUPPORTED). Regular expressions follow portable RE2 / ECMA-262 / Rust regex semantics without lookaround.",
  "$defs": {
    "SingleLine": {
      "type": "string",
      "not": { "pattern": "\n" },
      "x-seallink-refusal": "WIRE_STRING"
    },
    "Hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": { "pattern": "\n" }
    },
    "XOnlyPubkey64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": { "pattern": "\n" },
      "x-seallink-refusal": "WIRE_KEY",
      "description": "Valid BIP-340 x-only secp256k1 public key."
    },
    "CompressedPubkey66": {
      "type": "string",
      "pattern": "^0[23][0-9a-f]{64}$",
      "not": { "pattern": "\n" },
      "x-seallink-refusal": "WIRE_KEY",
      "description": "Valid compressed secp256k1 public key (SEC 1)."
    },
    "Ed25519Pubkey64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": { "pattern": "\n" },
      "x-seallink-refusal": "WIRE_KEY",
      "description": "Valid canonical non-small-order Ed25519 compressed public key (RFC 8032 / SPEC-01 §4.1)."
    },
    "Sig128": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$",
      "not": { "pattern": "\n" },
      "x-seallink-refusal": "WIRE_SIGNATURE",
      "description": "Strict 64-byte signature (BIP-340, P-256 low-S raw r||s, or strict canonical non-small-order Ed25519) in lowercase hex."
    },
    "Uint53": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "x-seallink-refusal": "WIRE_INTEGER"
    },
    "PositiveUint53": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "x-seallink-refusal": "WIRE_INTEGER"
    },
    "Vout": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295,
      "x-seallink-refusal": "WIRE_INTEGER"
    },
    "Uint64Str": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1([0-7][0-9]{18}|8([0-3][0-9]{17}|4([0-3][0-9]{16}|4([0-5][0-9]{15}|6([0-6][0-9]{14}|7([0-3][0-9]{13}|4([0-3][0-9]{12}|40([0-6][0-9]{10}|7([0-2][0-9]{9}|3([0-6][0-9]{8}|70([0-8][0-9]{6}|9([0-4][0-9]{5}|5([0-4][0-9]{4}|5(0[0-9]{3}|1([0-5][0-9]{2}|6(0[0-9]|1[0-5])))))))))))))))))$",
      "not": { "pattern": "\n" },
      "x-seallink-refusal": "WIRE_INTEGER",
      "description": "Exact unsigned 64-bit integer encoded as canonical decimal string (0 <= v <= 18446744073709551615)."
    },
    "Network": {
      "type": "string",
      "enum": ["main", "regtest"]
    },
    "NameStr": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9][a-z0-9./_-]{0,254}$",
      "not": { "pattern": "\n" }
    },
    "PartyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "not": { "pattern": "\n" },
      "description": "Unique-within-contract party identifier disambiguating multiple parties sharing a legal role."
    },
    "ActionStr": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9._-]+(/[a-z0-9._-]+)+$",
      "not": { "pattern": "\n" }
    },
    "ServiceTypeStr": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(mail|agent-session|xmpp|blob|wallet|names|compute|rental|[a-z0-9-]+(\\.[a-z0-9-]+)+/[a-z0-9][a-z0-9._-]{0,63})$",
      "not": { "pattern": "\n" }
    },
    "QuotaKindStr": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^(seallink/[a-z0-9._-]+|[a-z0-9-]+(\\.[a-z0-9-]+)+/[a-z0-9._-]+)$",
      "not": { "pattern": "\n" },
      "x-seallink-refusal": "WIRE_CONSTRAINT"
    },
    "RelayUri": {
      "type": "string",
      "minLength": 6,
      "maxLength": 512,
      "pattern": "^wss?://[^\\r\\n\u2028\u2029]+$",
      "not": { "pattern": "\n" }
    },
    "Outpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["txid", "vout"],
      "properties": {
        "txid": { "$ref": "#/$defs/Hex64" },
        "vout": { "$ref": "#/$defs/Vout" }
      }
    },
    "BranchKeySpec": {
      "description": "Canonical ECDSA branch signer: either a single compressed secp256k1 key (including MPC/threshold-ECDSA per OQ-007) or a compact native P2WSH m-of-n multisig (2 <= n <= 5, 1 <= m <= n, strictly sorted pks; single-key object form forbidden to prevent dual encoding).",
      "oneOf": [
        { "$ref": "#/$defs/CompressedPubkey66" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["m", "pks"],
          "properties": {
            "m": { "type": "integer", "minimum": 1, "maximum": 5, "x-seallink-refusal": "WIRE_INTEGER" },
            "pks": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5,
              "uniqueItems": true,
              "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED",
              "items": { "$ref": "#/$defs/CompressedPubkey66" }
            }
          }
        }
      ]
    },
    "P2wpkhScriptPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "pk"],
      "properties": {
        "kind": { "const": "key", "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED" },
        "pk": { "$ref": "#/$defs/CompressedPubkey66" }
      }
    },
    "SingleUseScriptPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "template", "keys"],
      "properties": {
        "kind": { "const": "branch", "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED" },
        "template": { "const": "single_use_1_of_2", "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED" },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "grantee"],
          "properties": {
            "issuer": { "$ref": "#/$defs/CompressedPubkey66" },
            "grantee": { "$ref": "#/$defs/CompressedPubkey66" }
          }
        }
      }
    },
    "ContractSealScriptPolicy": {
      "description": "Allowed ScriptPolicy templates for contract termination seals (forbids single_use_1_of_2 and guardian_slot_pending).",
      "oneOf": [
        { "$ref": "#/$defs/P2wpkhScriptPolicy" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "m", "pks"],
          "properties": {
            "kind": { "const": "multisig", "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED" },
            "m": { "type": "integer", "minimum": 1, "maximum": 15, "x-seallink-refusal": "WIRE_INTEGER" },
            "pks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 15,
              "uniqueItems": true,
              "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED",
              "items": { "$ref": "#/$defs/CompressedPubkey66" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "template", "keys"],
          "properties": {
            "kind": { "const": "branch", "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED" },
            "template": { "enum": ["either_of_2", "both_of_2"], "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED" },
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "required": ["a", "b"],
              "properties": {
                "a": { "$ref": "#/$defs/BranchKeySpec" },
                "b": { "$ref": "#/$defs/BranchKeySpec" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "template", "keys"],
          "properties": {
            "kind": { "const": "branch", "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED" },
            "template": { "const": "arbiter_or_both", "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED" },
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "required": ["a", "b", "arbiter"],
              "properties": {
                "a": { "$ref": "#/$defs/CompressedPubkey66" },
                "b": { "$ref": "#/$defs/CompressedPubkey66" },
                "arbiter": { "$ref": "#/$defs/BranchKeySpec" }
              }
            }
          }
        }
      ]
    },
    "ScriptPolicy": {
      "oneOf": [
        { "$ref": "#/$defs/P2wpkhScriptPolicy" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "m", "pks"],
          "properties": {
            "kind": { "const": "multisig", "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED" },
            "m": { "type": "integer", "minimum": 1, "maximum": 15, "x-seallink-refusal": "WIRE_INTEGER" },
            "pks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 15,
              "uniqueItems": true,
              "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED",
              "items": { "$ref": "#/$defs/CompressedPubkey66" },
              "description": "Strictly sorted in ascending lexicographical hex order; verifier MUST also enforce 1 <= m <= len(pks) and distinct x-coordinates."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "template", "keys"],
          "properties": {
            "kind": { "const": "branch", "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED" },
            "template": { "enum": ["either_of_2", "both_of_2"], "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED" },
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "required": ["a", "b"],
              "properties": {
                "a": { "$ref": "#/$defs/BranchKeySpec" },
                "b": { "$ref": "#/$defs/BranchKeySpec" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "template", "keys"],
          "properties": {
            "kind": { "const": "branch", "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED" },
            "template": { "const": "arbiter_or_both", "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED" },
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "required": ["a", "b", "arbiter"],
              "properties": {
                "a": { "$ref": "#/$defs/CompressedPubkey66" },
                "b": { "$ref": "#/$defs/CompressedPubkey66" },
                "arbiter": { "$ref": "#/$defs/BranchKeySpec" }
              }
            }
          }
        },
        { "$ref": "#/$defs/SingleUseScriptPolicy" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "template", "keys", "delay_blocks"],
          "properties": {
            "kind": { "const": "branch", "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED" },
            "template": { "const": "guardian_slot_pending", "x-seallink-refusal": "CHAIN_SCRIPT_UNSUPPORTED" },
            "keys": {
              "type": "object",
              "additionalProperties": false,
              "required": ["disposer", "challenger", "guardian"],
              "properties": {
                "disposer": { "$ref": "#/$defs/BranchKeySpec" },
                "challenger": { "$ref": "#/$defs/BranchKeySpec" },
                "guardian": { "$ref": "#/$defs/CompressedPubkey66" }
              }
            },
            "delay_blocks": { "type": "integer", "minimum": 1, "maximum": 52560, "x-seallink-refusal": "WIRE_INTEGER" }
          }
        }
      ]
    },
    "NamePin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "registration", "owner_policy"],
      "properties": {
        "name": { "$ref": "#/$defs/NameStr" },
        "registration": { "$ref": "#/$defs/Outpoint" },
        "owner_policy": { "$ref": "#/$defs/ScriptPolicy" }
      }
    },
    "RoleIssuerPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "registration", "owner_policy", "role_policy"],
      "properties": {
        "name": { "$ref": "#/$defs/NameStr" },
        "registration": { "$ref": "#/$defs/Outpoint" },
        "owner_policy": { "$ref": "#/$defs/ScriptPolicy" },
        "role_policy": { "$ref": "#/$defs/ThresholdPolicy" }
      }
    },
    "Seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["txid", "vout", "script_policy"],
      "properties": {
        "txid": { "$ref": "#/$defs/Hex64" },
        "vout": { "$ref": "#/$defs/Vout" },
        "script_policy": { "$ref": "#/$defs/ScriptPolicy" }
      }
    },
    "P2wpkhSeal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["txid", "vout", "script_policy"],
      "properties": {
        "txid": { "$ref": "#/$defs/Hex64" },
        "vout": { "$ref": "#/$defs/Vout" },
        "script_policy": { "$ref": "#/$defs/P2wpkhScriptPolicy" }
      }
    },
    "ThresholdPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["m", "pks"],
      "description": "Canonical single-encoding BIP-340 m-of-n threshold policy (alg MUST be omitted; strictly sorted ascending XOnlyPubkey64 pks; 1 <= m <= len(pks)).",
      "properties": {
        "m": { "type": "integer", "minimum": 1, "maximum": 32, "x-seallink-refusal": "WIRE_INTEGER" },
        "pks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/XOnlyPubkey64" }
        }
      }
    },
    "DeviceThresholdPolicy": {
      "description": "Canonical device-capable threshold policy: omits alg for BIP-340 (explicit alg='bip340' forbidden), or specifies alg='p256' (CompressedPubkey66) or alg='ed25519' (Ed25519Pubkey64).",
      "oneOf": [
        { "$ref": "#/$defs/ThresholdPolicy" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["alg", "m", "pks"],
          "properties": {
            "alg": { "const": "p256" },
            "m": { "type": "integer", "minimum": 1, "maximum": 32, "x-seallink-refusal": "WIRE_INTEGER" },
            "pks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/CompressedPubkey66" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["alg", "m", "pks"],
          "properties": {
            "alg": { "const": "ed25519" },
            "m": { "type": "integer", "minimum": 1, "maximum": 32, "x-seallink-refusal": "WIRE_INTEGER" },
            "pks": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/Ed25519Pubkey64" }
            }
          }
        }
      ]
    },
    "SignatureEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pk", "sig"],
      "properties": {
        "pk": { "$ref": "#/$defs/XOnlyPubkey64" },
        "sig": { "$ref": "#/$defs/Sig128" }
      }
    },
    "DeviceSignatureEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pk", "sig"],
      "properties": {
        "pk": { "type": "string", "pattern": "^([0-9a-f]{64}|0[23][0-9a-f]{64})$", "not": { "pattern": "\n" }, "x-seallink-refusal": "WIRE_KEY" },
        "sig": { "$ref": "#/$defs/Sig128" }
      }
    },
    "SignatureSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "sigs"],
      "description": "BIP-340 SignatureSet; sigs MUST be strictly sorted in ascending lexicographical pk order.",
      "properties": {
        "policy": { "$ref": "#/$defs/ThresholdPolicy" },
        "sigs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/SignatureEntry" }
        }
      }
    },
    "DeviceSignatureSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "sigs"],
      "description": "Device-capable SignatureSet (BIP-340, P-256 low-S, or strict canonical Ed25519); sigs MUST be strictly sorted in ascending lexicographical pk order.",
      "properties": {
        "policy": { "$ref": "#/$defs/DeviceThresholdPolicy" },
        "sigs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/DeviceSignatureEntry" }
        }
      }
    },
    "GuardianApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "revision", "guardian_name", "signatures"],
      "properties": {
        "slot": { "type": "integer", "minimum": 1, "maximum": 32, "x-seallink-refusal": "WIRE_INTEGER" },
        "revision": { "$ref": "#/$defs/PositiveUint53" },
        "guardian_name": { "$ref": "#/$defs/NameStr" },
        "signatures": { "$ref": "#/$defs/SignatureSet" }
      }
    },
    "GuardianApprovals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/GuardianApproval" },
      "description": "Ordered by strictly ascending slot number. Each entry's SignatureSet MUST exactly match that active slot guardian's resolved link.grant policy."
    },
    "GuardianEventClass": {
      "type": "string",
      "enum": ["routine_read", "effect_grant", "contract_assent", "custody_change"],
      "description": "Strict linear precedence: routine_read < effect_grant < contract_assent < custody_change."
    },
    "GuardianContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_id", "ward_name", "revision", "event_class"],
      "properties": {
        "origin_id": { "$ref": "#/$defs/Hex64" },
        "ward_name": { "$ref": "#/$defs/NameStr" },
        "revision": { "$ref": "#/$defs/PositiveUint53" },
        "event_class": { "$ref": "#/$defs/GuardianEventClass" }
      }
    },
    "RationalQuorum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["num", "den", "min"],
      "properties": {
        "num": { "type": "integer", "minimum": 1, "maximum": 32, "x-seallink-refusal": "WIRE_INTEGER" },
        "den": { "type": "integer", "minimum": 1, "maximum": 32, "x-seallink-refusal": "WIRE_INTEGER" },
        "min": { "type": "integer", "minimum": 1, "maximum": 32, "x-seallink-refusal": "WIRE_INTEGER" }
      },
      "description": "Verifier MUST enforce 1 <= num <= den and 1 <= min <= revision_size."
    },
    "QuorumMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routine_read", "effect_grant", "contract_assent", "custody_change"],
      "description": "Verifier MUST enforce non-decreasing monotonicity: required(routine_read) <= required(effect_grant) <= required(contract_assent) <= required(custody_change) for revision_size.",
      "properties": {
        "routine_read": { "$ref": "#/$defs/RationalQuorum" },
        "effect_grant": { "$ref": "#/$defs/RationalQuorum" },
        "contract_assent": { "$ref": "#/$defs/RationalQuorum" },
        "custody_change": { "$ref": "#/$defs/RationalQuorum" }
      }
    },
    "MerkleProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "leaf_digest", "steps"],
      "properties": {
        "root": { "$ref": "#/$defs/Hex64" },
        "leaf_digest": { "$ref": "#/$defs/Hex64" },
        "steps": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["side", "hash"],
            "properties": {
              "side": { "type": "string", "enum": ["L", "R"] },
              "hash": { "$ref": "#/$defs/Hex64" }
            }
          }
        }
      }
    },
    "ProofPathEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant_id"],
      "properties": {
        "grant_id": { "$ref": "#/$defs/Hex64" },
        "issuance_txid": { "$ref": "#/$defs/Hex64" },
        "batch_proof": { "$ref": "#/$defs/MerkleProof" }
      }
    },
    "ConstraintPredicate": {
      "x-seallink-refusal": "WIRE_CONSTRAINT",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["eq"],
          "properties": { "eq": { "type": ["string", "boolean"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["in"],
          "properties": {
            "in": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/SingleLine" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not_in"],
          "properties": {
            "not_in": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/SingleLine" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["prefix"],
          "properties": { "prefix": { "type": "string", "minLength": 1, "maxLength": 512, "not": { "pattern": "\n" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["suffix"],
          "properties": { "suffix": { "type": "string", "minLength": 1, "maxLength": 512, "not": { "pattern": "\n" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["range"],
          "properties": {
            "range": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "$ref": "#/$defs/Uint64Str" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["hash_eq"],
          "properties": { "hash_eq": { "$ref": "#/$defs/Hex64" } }
        }
      ]
    },
    "Quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "resource", "unit", "max", "window"],
      "x-seallink-refusal": "WIRE_CONSTRAINT",
      "properties": {
        "kind": { "$ref": "#/$defs/QuotaKindStr" },
        "resource": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "\n" } },
        "unit": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
        "max": { "$ref": "#/$defs/Uint64Str" },
        "window": { "type": "string", "pattern": "^(term|blocks:[1-9][0-9]{0,8}|seconds:[1-9][0-9]{0,9})$", "not": { "pattern": "\n" } }
      }
    },
    "Capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target"],
      "properties": {
        "action": { "$ref": "#/$defs/ActionStr" },
        "target": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "\n" } },
        "where": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": { "$ref": "#/$defs/ConstraintPredicate" }
        },
        "quotas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/Quota" }
        },
        "extensions": {
          "not": {},
          "x-seallink-refusal": "WIRE_CONSTRAINT",
          "description": "Reserved for future versions; any presence MUST refuse with WIRE_CONSTRAINT."
        }
      }
    },
    "SetPin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "sha256"],
      "properties": {
        "seq": { "$ref": "#/$defs/PositiveUint53" },
        "sha256": { "$ref": "#/$defs/Hex64" }
      }
    },
    "ChainViewTipRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hash", "height"],
      "properties": {
        "hash": { "$ref": "#/$defs/Hex64" },
        "height": { "$ref": "#/$defs/Uint53" },
        "now": { "$ref": "#/$defs/Uint53" }
      }
    },
    "ChainViewComparisonPeer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "healthy", "height", "hash_at_tip"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } },
            "healthy": { "const": true },
            "height": { "$ref": "#/$defs/Uint53" },
            "hash_at_tip": { "$ref": "#/$defs/Hex64" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "healthy"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } },
            "healthy": { "const": false },
            "height": { "$ref": "#/$defs/Uint53" },
            "hash_at_tip": { "$ref": "#/$defs/Hex64" }
          }
        }
      ]
    },
    "ChainViewSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "description": "Normative ChainView observation snapshot ABI (SL-LDGR-015, SPEC-02 §2.2). Every required field MUST be populated by cold adapters; omitted or malformed required fields fail closed.",
      "required": [
        "network", "genesis", "tip_height", "tip_hash", "tip_header_time", "tip_first_sight",
        "now", "clock_watermark", "best_header_height", "in_ibd", "txindex", "node_reachable",
        "observation_bracket", "comparison_peers", "blocks", "txs", "names"
      ],
      "properties": {
        "network": { "$ref": "#/$defs/Network" },
        "genesis": { "$ref": "#/$defs/Hex64" },
        "tip_height": { "$ref": "#/$defs/Uint53" },
        "tip_hash": { "$ref": "#/$defs/Hex64" },
        "tip_header_time": { "$ref": "#/$defs/Uint53" },
        "tip_first_sight": { "$ref": "#/$defs/Uint53" },
        "tip_median_time_past": { "$ref": "#/$defs/Uint53" },
        "now": { "$ref": "#/$defs/Uint53" },
        "clock_watermark": { "$ref": "#/$defs/Uint53" },
        "clock_source": { "type": "string", "enum": ["operational_utc", "operational_persisted", "operational_memory", "regtest_deterministic"] },
        "credible_utc_interval": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/Uint53" }
        },
        "best_header_height": { "$ref": "#/$defs/Uint53" },
        "in_ibd": { "type": "boolean" },
        "txindex": { "type": "boolean" },
        "node_reachable": { "type": "boolean" },
        "observation_bracket": {
          "type": "object",
          "additionalProperties": false,
          "required": ["consistent", "start", "end"],
          "properties": {
            "consistent": { "type": "boolean" },
            "start": { "$ref": "#/$defs/ChainViewTipRef" },
            "end": { "$ref": "#/$defs/ChainViewTipRef" },
            "attempts": { "$ref": "#/$defs/PositiveUint53" },
            "pre_effect_rechecked": { "type": "boolean" },
            "pre_effect_start": { "$ref": "#/$defs/ChainViewTipRef" },
            "pre_effect_end": { "$ref": "#/$defs/ChainViewTipRef" },
            "pre_effect_tip": { "$ref": "#/$defs/ChainViewTipRef" },
            "initial_snapshot": { "type": "object" }
          }
        },
        "rebracket_tip": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hash", "height"],
          "properties": {
            "hash": { "$ref": "#/$defs/Hex64" },
            "height": { "$ref": "#/$defs/Uint53" },
            "now": { "$ref": "#/$defs/Uint53" },
            "header_time": { "$ref": "#/$defs/Uint53" },
            "first_sight": { "$ref": "#/$defs/Uint53" }
          }
        },
        "comparison_peers": {
          "type": "array",
          "items": { "$ref": "#/$defs/ChainViewComparisonPeer" }
        },
        "blocks": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Uint53" }
        },
        "block_times": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Uint53" }
        },
        "txs": { "type": "object" },
        "names": { "type": "object" },
        "name_registrations": { "type": "object" },
        "registered_bindings": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/Hex64" }
        },
        "manifests": { "type": "object" }
      }
    }
  }
}
