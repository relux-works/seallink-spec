{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seallink.org/releases/v1.0.0-draft.15/schemas/contract.schema.json",
  "title": "SealLink v1.0 Contracts, Clauses, Assent, Termination & Violation Verdicts",
  "$defs": {
    "MachineClauseTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities"],
      "description": "Closed machine-enforced terms carried inside any clause listed in contract.machine_clause_indices[]. Every bound grant capability MUST narrow (<=) at least one declared clause capability via the 7-predicate Constraint Algebra and quota ceilings (SPEC-05 §2.1).",
      "properties": {
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "common.schema.json#/$defs/Capability" }
        },
        "config_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
        "not_before_height": { "$ref": "common.schema.json#/$defs/Uint53" },
        "not_after_height": { "$ref": "common.schema.json#/$defs/PositiveUint53" }
      }
    },
    "ClauseObject": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "description": "Canonical disclosed contract clause committed via H_tag('seallink-clause/1', salt_32B || JCS(clause_obj)). Clauses listed in machine_clause_indices[] MUST contain machine_terms.",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "\n" } },
        "text": { "type": "string", "minLength": 1, "maxLength": 16384, "x-seallink-allow-lf": true },
        "machine_terms": { "$ref": "#/$defs/MachineClauseTerms" }
      }
    },
    "Contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "network", "genesis", "profile", "contract_salt", "parties", "window", "clause_commitments"],
      "properties": {
        "type": { "const": "seallink-contract/1" },
        "network": { "$ref": "common.schema.json#/$defs/Network" },
        "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
        "profile": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9._-]+(/[a-z0-9._-]+)*$", "not": { "pattern": "\n" } },
        "contract_salt": { "$ref": "common.schema.json#/$defs/Hex64" },
        "parties": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "description": "Every party entry MUST carry a distinct party_id within the contract; multiple parties MAY share a legal role (e.g. co-tenants).",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["party_id", "role", "signing_policy"],
                "properties": {
                  "party_id": { "$ref": "common.schema.json#/$defs/PartyId" },
                  "role": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
                  "name_pin": { "$ref": "common.schema.json#/$defs/NamePin" },
                  "signing_policy": { "$ref": "common.schema.json#/$defs/ThresholdPolicy" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["party_id", "role", "ward_origin_id", "name_pin"],
                "properties": {
                  "party_id": { "$ref": "common.schema.json#/$defs/PartyId" },
                  "role": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
                  "ward_origin_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                  "name_pin": { "$ref": "common.schema.json#/$defs/NamePin" }
                }
              }
            ]
          }
        },
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["not_before_height"],
          "properties": {
            "not_before_height": { "$ref": "common.schema.json#/$defs/Uint53" },
            "not_after_height": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
            "not_after_unix": { "$ref": "common.schema.json#/$defs/Uint53" }
          }
        },
        "clause_commitments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "common.schema.json#/$defs/Hex64" },
          "description": "Ordered H_tag('seallink-clause/1', salt_32B || canonical_JCS(ClauseObject)) per SPEC-01 §5 using independent 32-byte CSPRNG salts."
        },
        "machine_clause_indices": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Uint53" },
          "description": "Strictly sorted zero-based indices into clause_commitments[] carrying machine-enforced terms; executors MUST require disclosure of every listed index."
        },
        "framework_id": { "$ref": "common.schema.json#/$defs/Hex64" },
        "seal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["txid", "vout", "script_policy"],
          "properties": {
            "txid": { "$ref": "common.schema.json#/$defs/Hex64" },
            "vout": { "$ref": "common.schema.json#/$defs/Vout" },
            "script_policy": { "$ref": "common.schema.json#/$defs/ContractSealScriptPolicy" }
          }
        },
        "assent_output": {
          "$ref": "common.schema.json#/$defs/Seal",
          "description": "Optional N-of-N P2WSH assent output spent by the 0x07 contract anchor transaction. For historical verification (anchor_height != None) of contracts with a ward party, either assent_output spent by the 0x07 anchor tx OR on-chain 0x01/0x02 anchoring of each ward seallink-assent/1 at h_assent <= anchor_height is MANDATORY (prevents post-emancipation/post-halt backdating)."
        },
        "config_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
        "moderation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rules_sha256", "moderator_key", "moderator_kind"],
          "properties": {
            "rules_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
            "moderator_key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" },
            "moderator_kind": { "type": "string", "enum": ["person", "agent", "organization"] }
          }
        }
      }
    },
    "AssentPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "network", "genesis", "target_type", "target_id", "party_id", "party_role", "issued_at", "expires_at", "nonce"],
      "properties": {
        "type": { "const": "seallink-assent/1" },
        "network": { "$ref": "common.schema.json#/$defs/Network" },
        "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
        "target_type": {
          "type": "string",
          "enum": ["seallink-contract/1", "seallink-guardian/1", "seallink-migration/1"]
        },
        "target_id": { "$ref": "common.schema.json#/$defs/Hex64" },
        "party_id": { "$ref": "common.schema.json#/$defs/PartyId" },
        "party_role": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
        "party_name": { "$ref": "common.schema.json#/$defs/NameStr" },
        "guardian_context": { "$ref": "common.schema.json#/$defs/GuardianContext" },
        "issued_at": { "$ref": "common.schema.json#/$defs/Uint53" },
        "expires_at": { "$ref": "common.schema.json#/$defs/Uint53" },
        "nonce": { "$ref": "common.schema.json#/$defs/Hex64" }
      },
      "allOf": [
        {
          "if": { "required": ["target_type"], "properties": { "target_type": { "enum": ["seallink-guardian/1", "seallink-migration/1"] } } },
          "then": { "required": ["party_name"] }
        }
      ]
    },
    "Assent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["payload", "signatures"],
          "properties": {
            "payload": {
              "allOf": [
                { "$ref": "#/$defs/AssentPayload" },
                { "not": { "required": ["guardian_context"] } }
              ]
            },
            "signatures": { "$ref": "common.schema.json#/$defs/SignatureSet" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["payload", "guardian_approvals"],
          "properties": {
            "payload": {
              "allOf": [
                { "$ref": "#/$defs/AssentPayload" },
                { "required": ["guardian_context"] }
              ]
            },
            "guardian_approvals": { "$ref": "common.schema.json#/$defs/GuardianApprovals" }
          }
        }
      ]
    },
    "TerminationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "network", "genesis", "contract_id", "termination_branch", "reason", "issued_at"],
      "properties": {
        "type": { "const": "seallink-termination/1" },
        "network": { "$ref": "common.schema.json#/$defs/Network" },
        "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
        "contract_id": { "$ref": "common.schema.json#/$defs/Hex64" },
        "termination_branch": { "type": "string", "enum": ["issuer_only", "either_party", "both_together", "arbiter"] },
        "reason": { "type": "string", "minLength": 1, "maxLength": 2048, "x-seallink-allow-lf": true },
        "verdict_id": { "$ref": "common.schema.json#/$defs/Hex64" },
        "guardian_context": { "$ref": "common.schema.json#/$defs/GuardianContext" },
        "issued_at": { "$ref": "common.schema.json#/$defs/Uint53" }
      }
    },
    "TerminationStatement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["payload", "signatures"],
          "properties": {
            "payload": {
              "allOf": [
                { "$ref": "#/$defs/TerminationPayload" },
                { "not": { "required": ["guardian_context"] } }
              ]
            },
            "signatures": { "$ref": "common.schema.json#/$defs/SignatureSet" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["payload", "guardian_approvals"],
          "properties": {
            "payload": {
              "allOf": [
                { "$ref": "#/$defs/TerminationPayload" },
                { "required": ["guardian_context"] }
              ]
            },
            "guardian_approvals": { "$ref": "common.schema.json#/$defs/GuardianApprovals" }
          }
        }
      ]
    },
    "Verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "signatures"],
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "network", "genesis", "grant_id", "contract_id", "rules_sha256", "violated_rule", "request_salted_sha256", "response_salted_sha256", "ordinal", "tip_height"],
          "properties": {
            "type": { "const": "seallink-verdict/1" },
            "network": { "$ref": "common.schema.json#/$defs/Network" },
            "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
            "grant_id": { "$ref": "common.schema.json#/$defs/Hex64" },
            "contract_id": { "$ref": "common.schema.json#/$defs/Hex64" },
            "rules_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
            "violated_rule": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } },
            "request_salted_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
            "response_salted_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
            "ordinal": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
            "prev_verdict_id": { "$ref": "common.schema.json#/$defs/Hex64" },
            "tip_height": { "$ref": "common.schema.json#/$defs/Uint53" }
          },
          "allOf": [
            {
              "if": { "required": ["ordinal"], "properties": { "ordinal": { "type": "integer", "const": 1 } } },
              "then": { "not": { "required": ["prev_verdict_id"] } }
            },
            {
              "if": { "required": ["ordinal"], "properties": { "ordinal": { "type": "integer", "minimum": 2 } } },
              "then": { "required": ["prev_verdict_id"] }
            }
          ]
        },
        "signatures": { "$ref": "common.schema.json#/$defs/SignatureSet" }
      }
    }
  }
}
