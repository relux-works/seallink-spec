{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seallink.org/schemas/v1/profile-agent.schema.json",
  "title": "SealLink PROFILE-agent-v1 Action Arguments and Result Schemas",
  "$defs": {
    "AgentBriefArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "brief_sha256", "max_duration_sec"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "brief_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
        "max_duration_sec": { "$ref": "common.schema.json#/$defs/Uint64Str" },
        "artifact_channel": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "AgentBriefResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "status", "output_sha256", "completed_at"],
      "properties": {
        "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "type": "string", "enum": ["completed", "stopped", "failed"] },
        "output_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
        "completed_at": { "$ref": "common.schema.json#/$defs/Uint53" }
      }
    },
    "AgentToolArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "input_sha256", "max_output_bytes"],
      "properties": {
        "tool_name": { "type": "string", "pattern": "^[a-z0-9._-]+$", "maxLength": 128 },
        "input_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
        "resource_path": { "type": "string", "minLength": 1, "maxLength": 512 },
        "max_output_bytes": { "$ref": "common.schema.json#/$defs/Uint64Str" }
      }
    },
    "AgentToolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool_name", "exit_code", "output_sha256", "output_bytes"],
      "properties": {
        "tool_name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "exit_code": { "$ref": "common.schema.json#/$defs/Uint53" },
        "output_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
        "output_bytes": { "$ref": "common.schema.json#/$defs/Uint64Str" }
      }
    },
    "AgentSessionArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "session_slot", "config_sha256"],
      "properties": {
        "op": { "type": "string", "enum": ["start", "checkpoint", "halt"] },
        "session_slot": { "type": "string", "minLength": 1, "maxLength": 128 },
        "config_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
        "max_wall_sec": { "$ref": "common.schema.json#/$defs/Uint64Str" }
      }
    },
    "AgentSessionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["session_slot", "state", "config_sha256", "recorded_at"],
      "properties": {
        "session_slot": { "type": "string", "minLength": 1, "maxLength": 128 },
        "state": { "type": "string", "enum": ["running", "checkpointed", "halted"] },
        "config_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
        "recorded_at": { "$ref": "common.schema.json#/$defs/Uint53" }
      }
    },
    "AgentGuardianMessageArgs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin_id", "revision", "message_sha256"],
      "properties": {
        "origin_id": { "$ref": "common.schema.json#/$defs/Hex64" },
        "revision": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
        "message_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
        "channel": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "AgentGuardianMessageResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delivered", "frame_sha256", "verified_slots", "recorded_at"],
      "properties": {
        "delivered": { "type": "boolean" },
        "frame_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
        "verified_slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 32 }
        },
        "recorded_at": { "$ref": "common.schema.json#/$defs/Uint53" }
      }
    }
  }
}
