                "recorded_at": { "$ref": "common.schema.json#/$defs/Uint53" },
                "debits": {
                  "type": "array",
                  "maxItems": 96,
                  "items": { "$ref": "#/$defs/JournalReservationLine" }
                }
              }
            }
          }
        },
        {
          "type": "object",
