                "denials_root": { "$ref": "common.schema.json#/$defs/Hex64" },
                "checkpoints_root": { "$ref": "common.schema.json#/$defs/Hex64" },
                "terminal": { "type": "boolean" }
              }
            }
          }
        }
      ]
    },
    "MigrationInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migration_id", "holder_name", "service_type", "items"],
      "description": "Strict allowlist portable export inventory committed by MigrationManifest.inventory_sha256 = SHA256(JCS(inventory)). No private keys, seeds, tokens, or live bearer secrets may appear.",
      "properties": {
        "migration_id": { "$ref": "common.schema.json#/$defs/Hex64" },
        "holder_name": { "$ref": "common.schema.json#/$defs/NameStr" },
        "service_type": { "$ref": "common.schema.json#/$defs/ServiceTypeStr" },
        "items": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "size_bytes", "media_type"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 512, "not": { "pattern": "(^|/)\\.\\.(/|$)|\n" } },
              "sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
              "size_bytes": { "$ref": "common.schema.json#/$defs/Uint64Str" },
              "media_type": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } }
            }
          }
        }
      }
    },
