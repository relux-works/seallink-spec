            "prev_commitment": { "$ref": "common.schema.json#/$defs/Hex64" },
            "kind": { "const": "reservation" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["invocation_id", "grant_id", "action", "nonce", "expires_at", "recorded_at", "reservations"],
              "description": "Atomic pre-effect commit: binds invocation_id, action, nonce, and complete quota reservation plan in signed capability.quotas[] order (own before row; empty [] for quota-free invocations) in a single CAS witness step.",
              "properties": {
                "invocation_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                "grant_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                "nonce": { "$ref": "common.schema.json#/$defs/Hex64" },
                "expires_at": { "$ref": "common.schema.json#/$defs/Uint53" },
                "recorded_at": { "$ref": "common.schema.json#/$defs/Uint53" },
                "reservations": {
                  "type": "array",
                  "maxItems": 64,
                  "items": { "$ref": "#/$defs/JournalReservationLine" }
                },
                "action": { "$ref": "common.schema.json#/$defs/ActionStr" },
                "single_use": { "const": true },
                "use_txid": { "$ref": "common.schema.json#/$defs/Hex64" }
              },
              "dependentRequired": {
                "single_use": ["use_txid"],
                "use_txid": ["single_use"]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "journal_id", "pos", "prev_commitment", "kind", "body"],
          "properties": {
            "type": { "const": "seallink-journal-entry/1" },
            "journal_id": { "$ref": "common.schema.json#/$defs/Hex64" },
            "pos": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
            "prev_commitment": { "$ref": "common.schema.json#/$defs/Hex64" },
            "kind": { "const": "settlement" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["invocation_id", "grant_id", "outcome", "receipt_sha256", "recorded_at", "settlements"],
              "description": "Unified atomic post-effect terminal commit (+1 witness advance): binds the persisted verified signed receipt content_addr, exact quota settlement lines (reconciled 1-to-1 with receipt.payload.settlements[]), and optional atomic single-use consumption closure (single_use_consumed + use_txid + closes_grant_id).",
              "properties": {
                "invocation_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                "grant_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                "outcome": { "type": "string", "enum": ["executed", "refused", "uncertain"] },
                "receipt_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
                "recorded_at": { "$ref": "common.schema.json#/$defs/Uint53" },
                "settlements": {
                  "type": "array",
                  "maxItems": 64,
                  "items": { "$ref": "#/$defs/JournalSettlementLine" }
                },
                "single_use_consumed": { "const": true },
                "use_txid": { "$ref": "common.schema.json#/$defs/Hex64" },
                "closes_grant_id": { "$ref": "common.schema.json#/$defs/Hex64" }
              },
              "dependentRequired": {
                "single_use_consumed": ["use_txid", "closes_grant_id"],
                "use_txid": ["single_use_consumed", "closes_grant_id"],
                "closes_grant_id": ["single_use_consumed", "use_txid"]
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "journal_id", "pos", "prev_commitment", "kind", "body"],
          "properties": {
            "type": { "const": "seallink-journal-entry/1" },
            "journal_id": { "$ref": "common.schema.json#/$defs/Hex64" },
            "pos": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
            "prev_commitment": { "$ref": "common.schema.json#/$defs/Hex64" },
            "kind": { "const": "single-use-consumed" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["grant_id", "invocation_id", "use_txid", "receipt_sha256", "recorded_at"],
              "properties": {
                "grant_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                "invocation_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                "use_txid": { "$ref": "common.schema.json#/$defs/Hex64" },
                "receipt_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
                "recorded_at": { "$ref": "common.schema.json#/$defs/Uint53" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "journal_id", "pos", "prev_commitment", "kind", "body"],
          "properties": {
            "type": { "const": "seallink-journal-entry/1" },
            "journal_id": { "$ref": "common.schema.json#/$defs/Hex64" },
            "pos": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
            "prev_commitment": { "$ref": "common.schema.json#/$defs/Hex64" },
            "kind": { "const": "nonce" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scope", "nonce", "invocation_id", "expires_at"],
              "properties": {
                "scope": { "type": "string", "enum": ["invocation", "auth", "assent", "owner-command", "session-open"] },
                "nonce": { "$ref": "common.schema.json#/$defs/Hex64" },
                "invocation_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                "expires_at": { "$ref": "common.schema.json#/$defs/Uint53" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "journal_id", "pos", "prev_commitment", "kind", "body"],
          "properties": {
            "type": { "const": "seallink-journal-entry/1" },
            "journal_id": { "$ref": "common.schema.json#/$defs/Hex64" },
