{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seallink.org/releases/v1.0.0-draft.11/schemas/invocation.schema.json",
  "title": "SealLink v1.0 Invocation, Receipt, Sessions, Auth, Owner Control, Journal & Migration",
  "$defs": {
    "Invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "signatures"],
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "network", "genesis", "executor", "action", "target", "arguments", "proof_path", "nonce", "iat", "exp"],
          "properties": {
            "type": { "const": "seallink-invocation/1" },
            "network": { "$ref": "common.schema.json#/$defs/Network" },
            "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
            "executor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "properties": {
                "name": { "$ref": "common.schema.json#/$defs/NameStr" },
                "key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" }
              }
            },
            "action": { "$ref": "common.schema.json#/$defs/ActionStr" },
            "target": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "\n" } },
            "arguments": {
              "type": "object",
              "maxProperties": 64,
              "description": "Closed per-action arguments object validated against registry/actions.json args_schema (e.g. profile-mail.schema.json, profile-agent.schema.json)."
            },
            "content_salt": { "$ref": "common.schema.json#/$defs/Hex64" },
            "proof_path": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": { "$ref": "common.schema.json#/$defs/ProofPathEntry" }
            },
            "nonce": { "$ref": "common.schema.json#/$defs/Hex64" },
            "iat": { "$ref": "common.schema.json#/$defs/Uint53" },
            "exp": { "$ref": "common.schema.json#/$defs/Uint53" }
          }
        },
        "signatures": { "$ref": "common.schema.json#/$defs/SignatureSet" }
      }
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "signatures"],
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "network", "genesis", "executor_name", "invocation_id", "grant_id", "action", "outcome", "tip_height", "tip_hash", "recorded_at"],
          "properties": {
            "type": { "const": "seallink-receipt/1" },
            "network": { "$ref": "common.schema.json#/$defs/Network" },
            "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
            "executor_name": { "$ref": "common.schema.json#/$defs/NameStr" },
            "invocation_id": { "$ref": "common.schema.json#/$defs/Hex64" },
            "grant_id": { "$ref": "common.schema.json#/$defs/Hex64" },
            "action": { "$ref": "common.schema.json#/$defs/ActionStr" },
            "outcome": { "type": "string", "enum": ["executed", "refused", "uncertain"] },
            "refusal_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$", "not": { "pattern": "\n" } },
            "settlements": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["account", "kind", "resource", "unit", "window", "reserved", "settled", "released"],
                "properties": {
                  "account": { "type": "string", "enum": ["own", "row", "session"] },
                  "row_ordinal": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                  "kind": { "$ref": "common.schema.json#/$defs/QuotaKindStr" },
                  "resource": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "\n" } },
                  "unit": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
                  "window": { "type": "string", "pattern": "^(term|blocks:[1-9][0-9]{0,8}|seconds:[1-9][0-9]{0,9})$", "not": { "pattern": "\n" } },
                  "reserved": { "$ref": "common.schema.json#/$defs/Uint64Str" },
                  "settled": { "$ref": "common.schema.json#/$defs/Uint64Str" },
                  "released": { "$ref": "common.schema.json#/$defs/Uint64Str" }
                },
                "if": { "required": ["account"], "properties": { "account": { "const": "row" } } },
                "then": { "required": ["row_ordinal"] },
                "else": { "not": { "required": ["row_ordinal"] } }
              }
            },
            "result_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
            "tip_height": { "$ref": "common.schema.json#/$defs/Uint53" },
            "tip_hash": { "$ref": "common.schema.json#/$defs/Hex64" },
            "recorded_at": { "$ref": "common.schema.json#/$defs/Uint53" }
          },
          "allOf": [
            {
              "if": { "required": ["outcome"], "properties": { "outcome": { "const": "refused" } } },
              "then": { "required": ["refusal_code"] },
              "else": { "not": { "required": ["refusal_code"] } }
            },
            {
              "if": { "required": ["outcome"], "properties": { "outcome": { "const": "executed" } } },
              "then": { "required": ["result_sha256"] }
            }
          ]
        },
        "signatures": { "$ref": "common.schema.json#/$defs/SignatureSet" }
      }
    },
    "SessionOpen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "signatures"],
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "network", "genesis", "executor", "proof_path", "op", "slot_binding", "quotas", "nonce", "iat", "exp"],
          "properties": {
            "type": { "const": "seallink-session-open/1" },
            "network": { "$ref": "common.schema.json#/$defs/Network" },
            "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
            "executor": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "key"],
              "properties": {
                "name": { "$ref": "common.schema.json#/$defs/NameStr" },
                "key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" }
              }
            },
            "proof_path": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": { "$ref": "common.schema.json#/$defs/ProofPathEntry" }
            },
            "op": { "type": "string", "enum": ["open", "extend", "close"] },
            "session_id": { "$ref": "common.schema.json#/$defs/Hex64" },
            "slot_binding": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "\n" } },
            "quotas": { "type": "array", "maxItems": 32, "items": { "$ref": "common.schema.json#/$defs/Quota" } },
            "nonce": { "$ref": "common.schema.json#/$defs/Hex64" },
            "iat": { "$ref": "common.schema.json#/$defs/Uint53" },
            "exp": { "$ref": "common.schema.json#/$defs/Uint53" }
          },
          "allOf": [
            {
              "if": { "required": ["op"], "properties": { "op": { "const": "open" } } },
              "then": { "not": { "required": ["session_id"] } }
            },
            {
              "if": { "required": ["op"], "properties": { "op": { "enum": ["extend", "close"] } } },
              "then": { "required": ["session_id"] }
            }
          ]
        },
        "signatures": { "$ref": "common.schema.json#/$defs/SignatureSet" }
      }
    },
    "AuthChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "signatures"],
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "service_id", "nonce", "issued_at", "expires_at", "auth_pubkey"],
          "properties": {
            "type": { "const": "seallink-auth-challenge/1" },
            "service_id": { "type": "string", "minLength": 1, "maxLength": 255, "not": { "pattern": "\n" } },
            "name": { "$ref": "common.schema.json#/$defs/NameStr" },
            "nonce": { "$ref": "common.schema.json#/$defs/Hex64" },
            "issued_at": { "$ref": "common.schema.json#/$defs/Uint53" },
            "expires_at": { "$ref": "common.schema.json#/$defs/Uint53" },
            "auth_pubkey": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" }
          }
        },
        "signatures": { "$ref": "common.schema.json#/$defs/SignatureSet" }
      }
    },
    "AuthUpgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "signatures"],
      "properties": {
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "service_id", "account_id", "name", "auth_pubkey", "firstupdate_txid", "nonce", "issued_at", "expires_at"],
          "properties": {
            "type": { "const": "seallink-auth-upgrade/1" },
            "service_id": { "type": "string", "minLength": 1, "maxLength": 255, "not": { "pattern": "\n" } },
            "account_id": { "type": "string", "minLength": 1, "maxLength": 255, "not": { "pattern": "\n" } },
            "name": { "$ref": "common.schema.json#/$defs/NameStr" },
            "auth_pubkey": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" },
            "firstupdate_txid": { "$ref": "common.schema.json#/$defs/Hex64" },
            "nonce": { "$ref": "common.schema.json#/$defs/Hex64" },
            "issued_at": { "$ref": "common.schema.json#/$defs/Uint53" },
            "expires_at": { "$ref": "common.schema.json#/$defs/Uint53" }
          }
        },
        "signatures": { "$ref": "common.schema.json#/$defs/SignatureSet" }
      }
    },
    "OwnerCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "signatures"],
      "properties": {
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "network", "genesis", "owner", "target_executor", "level", "command", "arguments", "nonce", "iat", "exp"],
              "properties": {
                "type": { "const": "seallink-owner-command/1" },
                "network": { "$ref": "common.schema.json#/$defs/Network" },
                "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
                "target_executor": { "type": "string", "minLength": 1, "maxLength": 255, "not": { "pattern": "\n" } },
                "level": { "type": "integer", "enum": [0, 1, 2] },
                "command": { "const": "agent-dispatch" },
                "arguments": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["run_id", "brief_sha256"],
                  "properties": {
                    "run_id": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } },
                    "brief_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "grant_id": { "$ref": "common.schema.json#/$defs/Hex64" }
                  }
                },
                "nonce": { "$ref": "common.schema.json#/$defs/Hex64" },
                "iat": { "$ref": "common.schema.json#/$defs/Uint53" },
                "exp": { "$ref": "common.schema.json#/$defs/Uint53" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "network", "genesis", "owner", "target_executor", "level", "command", "arguments", "nonce", "iat", "exp"],
              "properties": {
                "type": { "const": "seallink-owner-command/1" },
                "network": { "$ref": "common.schema.json#/$defs/Network" },
                "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
                "target_executor": { "type": "string", "minLength": 1, "maxLength": 255, "not": { "pattern": "\n" } },
                "level": { "type": "integer", "enum": [1, 2] },
                "command": { "const": "session-terminate" },
                "arguments": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["session_id", "reason"],
                  "properties": {
                    "session_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "reason": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "\n" } }
                  }
                },
                "nonce": { "$ref": "common.schema.json#/$defs/Hex64" },
                "iat": { "$ref": "common.schema.json#/$defs/Uint53" },
                "exp": { "$ref": "common.schema.json#/$defs/Uint53" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "network", "genesis", "owner", "target_executor", "level", "command", "arguments", "nonce", "iat", "exp"],
              "properties": {
                "type": { "const": "seallink-owner-command/1" },
                "network": { "$ref": "common.schema.json#/$defs/Network" },
                "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
                "target_executor": { "type": "string", "minLength": 1, "maxLength": 255, "not": { "pattern": "\n" } },
                "level": { "type": "integer", "const": 2 },
                "command": { "const": "policy-apply" },
                "arguments": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["statement_id", "config_sha256"],
                  "properties": {
                    "statement_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "config_sha256": { "$ref": "common.schema.json#/$defs/Hex64" }
                  }
                },
                "nonce": { "$ref": "common.schema.json#/$defs/Hex64" },
                "iat": { "$ref": "common.schema.json#/$defs/Uint53" },
                "exp": { "$ref": "common.schema.json#/$defs/Uint53" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "network", "genesis", "owner", "target_executor", "level", "command", "arguments", "nonce", "iat", "exp"],
              "properties": {
                "type": { "const": "seallink-owner-command/1" },
                "network": { "$ref": "common.schema.json#/$defs/Network" },
                "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
                "target_executor": { "type": "string", "minLength": 1, "maxLength": 255, "not": { "pattern": "\n" } },
                "level": { "type": "integer", "const": 2 },
                "command": { "const": "keyholder-halt" },
                "arguments": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["scope"],
                  "properties": {
                    "scope": { "type": "string", "enum": ["all", "run", "device"] },
                    "target_id": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } }
                  }
                },
                "nonce": { "$ref": "common.schema.json#/$defs/Hex64" },
                "iat": { "$ref": "common.schema.json#/$defs/Uint53" },
                "exp": { "$ref": "common.schema.json#/$defs/Uint53" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "network", "genesis", "owner", "target_executor", "level", "command", "arguments", "nonce", "iat", "exp"],
              "properties": {
                "type": { "const": "seallink-owner-command/1" },
                "network": { "$ref": "common.schema.json#/$defs/Network" },
                "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
                "target_executor": { "type": "string", "minLength": 1, "maxLength": 255, "not": { "pattern": "\n" } },
                "level": { "type": "integer", "const": 2 },
                "command": { "const": "approve-pii-disclosure" },
                "arguments": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["grant_id", "recipient_name", "fields_sha256", "route_mode"],
                  "properties": {
                    "grant_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "recipient_name": { "$ref": "common.schema.json#/$defs/NameStr" },
                    "fields_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "route_mode": { "const": "direct" }
                  }
                },
                "nonce": { "$ref": "common.schema.json#/$defs/Hex64" },
                "iat": { "$ref": "common.schema.json#/$defs/Uint53" },
                "exp": { "$ref": "common.schema.json#/$defs/Uint53" }
              }
            }
          ]
        },
        "signatures": { "$ref": "common.schema.json#/$defs/DeviceSignatureSet" }
      }
    },
    "BucketIdStr": {
      "type": "string",
      "pattern": "^(term|blk:[0-9]+|sec:[0-9]+)$",
      "not": { "pattern": "\n" }
    },
    "ClosureSubject": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_kind", "subject_id"],
          "properties": {
            "subject_kind": { "type": "string", "enum": ["grant", "contract", "credential", "origin"] },
            "subject_id": { "$ref": "common.schema.json#/$defs/Hex64" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_kind", "outpoint"],
          "properties": {
            "subject_kind": { "const": "seal" },
            "outpoint": { "$ref": "common.schema.json#/$defs/Outpoint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_kind", "grant_id", "ordinal"],
          "properties": {
            "subject_kind": { "const": "row" },
            "grant_id": { "$ref": "common.schema.json#/$defs/Hex64" },
            "ordinal": { "$ref": "common.schema.json#/$defs/PositiveUint53" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_kind", "name", "registration", "role", "policy_sha256"],
          "description": "Policy- and cause-scoped durable role closure (prevents routine A->B rotation or forged grants from closing successor policy B, prevents 0x0b CRED_ISSUER_CLOSED from overwriting NAME_ROLE_CHANGED, scopes NAME_ROLE_CHANGED by retired_before_height for A->B->A consistency, and scopes 0x0b CRED_ISSUER_CLOSED by cutoff_height = h_c).",
          "properties": {
            "subject_kind": { "const": "role" },
            "name": { "$ref": "common.schema.json#/$defs/NameStr" },
            "registration": { "$ref": "common.schema.json#/$defs/Outpoint" },
            "role": { "type": "string", "enum": ["grant", "cred", "notary", "release"] },
            "policy_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
            "cutoff_height": { "$ref": "common.schema.json#/$defs/Uint53" },
            "retired_before_height": { "$ref": "common.schema.json#/$defs/Uint53" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_kind", "origin_id", "slot", "outpoint"],
          "properties": {
            "subject_kind": { "const": "guardian_slot" },
            "origin_id": { "$ref": "common.schema.json#/$defs/Hex64" },
            "slot": { "type": "integer", "minimum": 1, "maximum": 32, "x-seallink-refusal": "WIRE_INTEGER" },
            "outpoint": { "$ref": "common.schema.json#/$defs/Outpoint" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["subject_kind", "log_id", "role"],
          "properties": {
            "subject_kind": { "const": "log" },
            "log_id": { "$ref": "common.schema.json#/$defs/Hex64" },
            "role": { "type": "string", "enum": ["notary", "release"] }
          }
        }
      ]
    },
    "JournalReservationLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "grant_id", "quota_kind", "resource", "unit", "window", "bucket_id", "amount"],
      "properties": {
        "account": { "type": "string", "enum": ["own", "row", "session"] },
        "row_ordinal": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
        "grant_id": { "$ref": "common.schema.json#/$defs/Hex64" },
        "quota_kind": { "$ref": "common.schema.json#/$defs/QuotaKindStr" },
        "resource": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "\n" } },
        "unit": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
        "window": { "type": "string", "pattern": "^(term|blocks:[1-9][0-9]{0,8}|seconds:[1-9][0-9]{0,9})$", "not": { "pattern": "\n" } },
        "bucket_id": { "$ref": "#/$defs/BucketIdStr" },
        "amount": { "$ref": "common.schema.json#/$defs/Uint64Str" }
      },
      "if": { "required": ["account"], "properties": { "account": { "const": "row" } } },
      "then": { "required": ["row_ordinal"] },
      "else": { "not": { "required": ["row_ordinal"] } }
    },
    "JournalSettlementLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "grant_id", "quota_kind", "resource", "unit", "window", "bucket_id", "settled", "released"],
      "properties": {
        "account": { "type": "string", "enum": ["own", "row", "session"] },
        "row_ordinal": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
        "grant_id": { "$ref": "common.schema.json#/$defs/Hex64" },
        "quota_kind": { "$ref": "common.schema.json#/$defs/QuotaKindStr" },
        "resource": { "type": "string", "minLength": 1, "maxLength": 256, "not": { "pattern": "\n" } },
        "unit": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
        "window": { "type": "string", "pattern": "^(term|blocks:[1-9][0-9]{0,8}|seconds:[1-9][0-9]{0,9})$", "not": { "pattern": "\n" } },
        "bucket_id": { "$ref": "#/$defs/BucketIdStr" },
        "settled": { "$ref": "common.schema.json#/$defs/Uint64Str" },
        "released": { "$ref": "common.schema.json#/$defs/Uint64Str" }
      },
      "if": { "required": ["account"], "properties": { "account": { "const": "row" } } },
      "then": { "required": ["row_ordinal"] },
      "else": { "not": { "required": ["row_ordinal"] } }
    },
    "JournalEntry": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "journal_id", "pos", "prev_commitment", "kind", "body"],
          "properties": {
            "type": { "const": "seallink-journal-entry/1" },
            "journal_id": { "$ref": "common.schema.json#/$defs/Hex64" },
            "pos": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
            "prev_commitment": { "$ref": "common.schema.json#/$defs/Hex64" },
            "kind": { "const": "closure" },
            "body": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subject", "cause", "observed_at"],
              "properties": {
                "subject": { "$ref": "#/$defs/ClosureSubject" },
                "cause": {
                  "type": "string",
                  "enum": [
                    "SEAL_SPENT", "NAME_ROLE_CHANGED", "SUBJECT_ENDED",
                    "CRED_ISSUER_CLOSED", "CRED_REVOKED_FOR_CAUSE",
                    "GRANT_CLOSED", "GRANT_ROW_STOPPED", "SINGLE_USE_CONSUMED",
                    "NOTARY_LOG_COMPROMISED"
                  ]
                },
                "spend_txid": { "$ref": "common.schema.json#/$defs/Hex64" },
                "observed_height": { "$ref": "common.schema.json#/$defs/Uint53" },
                "observed_at": { "$ref": "common.schema.json#/$defs/Uint53" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "journal_id", "pos", "prev_commitment", "kind", "body"],
