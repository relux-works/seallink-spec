{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seallink.org/releases/v1.0.0-draft.12/schemas/manifest.schema.json",
  "title": "SealLink v1.0 Manifest, Sets & Statements",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "network", "owner", "seq"],
  "properties": {
    "type": { "const": "seallink-manifest/1" },
    "network": { "$ref": "common.schema.json#/$defs/Network" },
    "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
    "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
    "sets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card": { "$ref": "common.schema.json#/$defs/SetPin" },
        "certs": { "$ref": "common.schema.json#/$defs/SetPin" },
        "devices": { "$ref": "common.schema.json#/$defs/SetPin" },
        "members": { "$ref": "common.schema.json#/$defs/SetPin" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_type", "actions", "receipt_key", "endpoint"],
      "properties": {
        "service_type": { "$ref": "common.schema.json#/$defs/ServiceTypeStr" },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/ActionStr" }
        },
        "receipt_key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" },
        "endpoint": { "type": "string", "minLength": 1, "maxLength": 1024, "not": { "pattern": "\n" } },
        "tls_spki_sha256": { "$ref": "common.schema.json#/$defs/Hex64" }
      }
    },
    "providers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service_type", "label", "provider"],
        "properties": {
          "service_type": { "$ref": "common.schema.json#/$defs/ServiceTypeStr" },
          "label": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "not": { "pattern": "\n" } },
          "provider": { "$ref": "common.schema.json#/$defs/NamePin" },
          "transport_key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" }
        }
      }
    },
    "auth_key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" },
    "auth_seal": { "$ref": "common.schema.json#/$defs/Seal" },
    "role_policies": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional preimages for on-chain link.<role>.p threshold pins. Zero authority unless SHA256(JCS(policy)) equals the confirmed on-chain link.<role>.p hash.",
      "properties": {
        "grant": { "$ref": "common.schema.json#/$defs/ThresholdPolicy" },
        "cred": { "$ref": "common.schema.json#/$defs/ThresholdPolicy" },
        "notary": { "$ref": "common.schema.json#/$defs/ThresholdPolicy" },
        "release": { "$ref": "common.schema.json#/$defs/ThresholdPolicy" }
      }
    },
    "notary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log"],
      "properties": {
        "policy_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
        "log": { "$ref": "#/$defs/LogBindingSpec" },
        "supported_claim_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9._-]+(/[a-z0-9._-]+)+$", "maxLength": 128, "not": { "pattern": "\n" } }
        },
        "supported_schemes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._/-]*$", "not": { "pattern": "\n" } }
        },
        "mirror_endpoints": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/MirrorEndpoint" }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_product_prefixes"],
      "properties": {
        "allowed_product_prefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-z0-9._-]+(/[a-z0-9._-]+)*/$", "not": { "pattern": "\n" } }
        },
        "log": { "$ref": "#/$defs/LogBindingSpec" },
        "supported_schemes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._/-]*$", "not": { "pattern": "\n" } }
        },
        "mirror_endpoints": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/MirrorEndpoint" }
        }
      }
    }
  },
  "dependentRequired": {
    "auth_key": ["auth_seal"],
    "auth_seal": ["auth_key"]
  },
  "$defs": {
    "LogBindingSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log_id", "genesis_seal", "heartbeat_max_blocks"],
      "properties": {
        "log_id": { "$ref": "common.schema.json#/$defs/Hex64" },
        "genesis_seal": { "$ref": "common.schema.json#/$defs/Seal" },
        "heartbeat_max_blocks": { "type": "integer", "minimum": 1, "maximum": 52560, "x-seallink-refusal": "WIRE_INTEGER" },
        "predecessor_logs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Hex64" }
        }
      }
    },
    "MirrorEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "minLength": 8, "maxLength": 512, "pattern": "^https://[^\\r\\n\u2028\u2029]+$", "not": { "pattern": "\n" } },
        "tls_spki_sha256": { "$ref": "common.schema.json#/$defs/Hex64" }
      }
    },
    "DeviceList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "network", "owner", "seq", "devices"],
      "properties": {
        "type": { "const": "seallink-device-list/1" },
        "network": { "$ref": "common.schema.json#/$defs/Network" },
        "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
        "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
        "devices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "alg", "key", "presence", "ceiling", "seal"],
                "properties": {
                  "label": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
                  "alg": { "const": "bip340" },
                  "key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" },
                  "presence": { "type": "boolean" },
                  "ceiling": { "type": "integer", "enum": [0, 1, 2] },
                  "seal": { "$ref": "common.schema.json#/$defs/Seal" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "alg", "key", "presence", "ceiling", "seal"],
                "properties": {
                  "label": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
                  "alg": { "const": "p256" },
                  "key": { "$ref": "common.schema.json#/$defs/CompressedPubkey66" },
                  "presence": { "type": "boolean" },
                  "ceiling": { "type": "integer", "enum": [0, 1, 2] },
                  "seal": { "$ref": "common.schema.json#/$defs/Seal" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "alg", "key", "presence", "ceiling", "seal"],
                "properties": {
                  "label": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
                  "alg": { "const": "ed25519" },
                  "key": { "$ref": "common.schema.json#/$defs/Ed25519Pubkey64" },
                  "presence": { "type": "boolean" },
                  "ceiling": { "type": "integer", "enum": [0, 1, 2] },
                  "seal": { "$ref": "common.schema.json#/$defs/Seal" }
                }
              }
            ]
          }
        }
      }
    },
    "MembersList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "network", "owner", "seq", "entries"],
      "properties": {
        "type": { "const": "seallink-members-list/1" },
        "network": { "$ref": "common.schema.json#/$defs/Network" },
        "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
        "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
        "entries": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "registration", "owner_policy", "seal"],
            "properties": {
              "name": { "$ref": "common.schema.json#/$defs/NameStr" },
              "registration": { "$ref": "common.schema.json#/$defs/Outpoint" },
              "owner_policy": { "$ref": "common.schema.json#/$defs/ScriptPolicy" },
              "seal": { "$ref": "common.schema.json#/$defs/Seal" }
            }
          }
        }
      }
    },
    "CertSetHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "network", "issuer_name", "seq", "count", "set_sha256"],
      "description": "Manifest-pinned head committing set_sha256 = SHA256(JCS(sorted_statement_content_addrs[])) over the actor's complete active statement set.",
      "properties": {
        "type": { "const": "seallink-certset-head/1" },
        "network": { "$ref": "common.schema.json#/$defs/Network" },
        "issuer_name": { "$ref": "common.schema.json#/$defs/NameStr" },
        "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
        "count": { "$ref": "common.schema.json#/$defs/Uint53" },
        "set_sha256": { "$ref": "common.schema.json#/$defs/Hex64" }
      }
    },
    "Statement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload", "signatures"],
      "properties": {
        "payload": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "network", "genesis", "issuer", "statement_kind", "subject", "seq", "not_before", "not_after", "body_sha256"],
              "properties": {
                "type": { "const": "seallink-statement/1" },
                "network": { "$ref": "common.schema.json#/$defs/Network" },
                "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
                "statement_kind": { "const": "config-section" },
                "subject": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["host_id", "section"],
                  "properties": {
                    "host_id": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } },
                    "section": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } }
                  }
                },
                "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                "not_before": { "$ref": "common.schema.json#/$defs/Uint53" },
                "not_after": { "$ref": "common.schema.json#/$defs/Uint53" },
                "body_sha256": { "$ref": "common.schema.json#/$defs/Hex64" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "network", "genesis", "issuer", "statement_kind", "subject", "seq", "not_before", "not_after"],
              "properties": {
                "type": { "const": "seallink-statement/1" },
                "network": { "$ref": "common.schema.json#/$defs/Network" },
                "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
                "statement_kind": { "const": "transport-binding" },
                "subject": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["transport", "endpoint", "key_alg", "key_hex"],
                      "properties": {
                        "transport": { "type": "string", "enum": ["https-tls-spki", "nostr", "matrix", "xmpp", "ssh"] },
                        "endpoint": { "type": "string", "minLength": 1, "maxLength": 512, "not": { "pattern": "\n" } },
                        "key_alg": { "type": "string", "enum": ["sha256-spki", "bip340", "ed25519"] },
                        "key_hex": { "$ref": "common.schema.json#/$defs/Hex64" }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["transport", "endpoint", "key_alg", "key_hex"],
                      "properties": {
                        "transport": { "type": "string", "enum": ["https-tls-spki", "nostr", "matrix", "xmpp", "ssh"] },
                        "endpoint": { "type": "string", "minLength": 1, "maxLength": 512, "not": { "pattern": "\n" } },
                        "key_alg": { "const": "p256" },
                        "key_hex": { "$ref": "common.schema.json#/$defs/CompressedPubkey66" }
                      }
                    }
                  ]
                },
                "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                "not_before": { "$ref": "common.schema.json#/$defs/Uint53" },
                "not_after": { "$ref": "common.schema.json#/$defs/Uint53" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "network", "genesis", "issuer", "statement_kind", "subject", "seq", "not_before", "not_after"],
              "properties": {
                "type": { "const": "seallink-statement/1" },
                "network": { "$ref": "common.schema.json#/$defs/Network" },
                "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
                "statement_kind": { "const": "root-rotate" },
                "subject": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["host_id", "new_role_policy"],
                  "properties": {
                    "host_id": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } },
                    "new_role_policy": { "$ref": "common.schema.json#/$defs/ThresholdPolicy" }
                  }
                },
                "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                "not_before": { "$ref": "common.schema.json#/$defs/Uint53" },
                "not_after": { "$ref": "common.schema.json#/$defs/Uint53" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "network", "genesis", "issuer", "statement_kind", "subject", "seq", "not_before", "not_after"],
              "properties": {
                "type": { "const": "seallink-statement/1" },
                "network": { "$ref": "common.schema.json#/$defs/Network" },
                "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
                "statement_kind": { "const": "root-cancel" },
                "subject": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["host_id", "override_id"],
                  "properties": {
                    "host_id": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } },
                    "override_id": { "$ref": "common.schema.json#/$defs/Hex64" }
                  }
                },
                "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                "not_before": { "$ref": "common.schema.json#/$defs/Uint53" },
                "not_after": { "$ref": "common.schema.json#/$defs/Uint53" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "network", "genesis", "issuer", "statement_kind", "subject", "seq", "not_before", "not_after"],
              "properties": {
                "type": { "const": "seallink-statement/1" },
                "network": { "$ref": "common.schema.json#/$defs/Network" },
                "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
                "statement_kind": { "const": "migration-accept" },
                "subject": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["migration_id", "holder", "source_executor", "inventory_sha256"],
                  "properties": {
                    "migration_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "holder": { "$ref": "common.schema.json#/$defs/NamePin" },
                    "source_executor": { "$ref": "common.schema.json#/$defs/NamePin" },
                    "inventory_sha256": { "$ref": "common.schema.json#/$defs/Hex64" }
                  }
                },
                "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                "not_before": { "$ref": "common.schema.json#/$defs/Uint53" },
                "not_after": { "$ref": "common.schema.json#/$defs/Uint53" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "network", "genesis", "issuer", "statement_kind", "subject", "seq", "not_before", "not_after"],
              "properties": {
                "type": { "const": "seallink-statement/1" },
                "network": { "$ref": "common.schema.json#/$defs/Network" },
                "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
                "statement_kind": { "const": "migration-fence" },
                "subject": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["migration_id", "holder", "dest_executor", "source_journal_pos", "source_journal_commitment", "inventory_sha256", "predecessor_grant_seals"],
                  "properties": {
                    "migration_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "holder": { "$ref": "common.schema.json#/$defs/NamePin" },
                    "dest_executor": { "$ref": "common.schema.json#/$defs/NamePin" },
                    "source_journal_pos": { "$ref": "common.schema.json#/$defs/Uint53" },
                    "source_journal_commitment": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "inventory_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "predecessor_grant_seals": {
                      "type": "array",
                      "maxItems": 256,
                      "items": { "$ref": "common.schema.json#/$defs/Seal" }
                    }
                  }
                },
                "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                "not_before": { "$ref": "common.schema.json#/$defs/Uint53" },
                "not_after": { "$ref": "common.schema.json#/$defs/Uint53" }
              }
            }
          ]
        },
        "signatures": { "$ref": "common.schema.json#/$defs/DeviceSignatureSet" }
      }
    }
  }
}
