{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seallink.org/releases/v1.0.0-draft.14/schemas/manifest.schema.json",
  "title": "SealLink v1.0 Manifest, Salted Sets & Statements",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "network", "owner", "seq"],
  "properties": {
    "type": { "const": "seallink-manifest/1" },
    "network": { "$ref": "common.schema.json#/$defs/Network" },
    "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
    "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
    "sets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "auth": { "$ref": "common.schema.json#/$defs/SetPin" },
        "card": { "$ref": "common.schema.json#/$defs/SetPin" },
        "certs": { "$ref": "common.schema.json#/$defs/SetPin" },
        "devices": { "$ref": "common.schema.json#/$defs/SetPin" },
        "members": { "$ref": "common.schema.json#/$defs/SetPin" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_type", "actions", "receipt_key", "endpoint"],
      "properties": {
        "service_type": { "$ref": "common.schema.json#/$defs/ServiceTypeStr" },
        "actions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/ActionStr" },
          "description": "Grant-delegated action strings executed by this service (may be [] for authentication-only services such as service_type='sso')."
        },
        "receipt_key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" },
        "endpoint": { "$ref": "common.schema.json#/$defs/HttpsUri" },
        "tls_spki_sha256": { "$ref": "common.schema.json#/$defs/Hex64" }
      }
    },
    "providers": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service_type", "label", "provider"],
        "properties": {
          "service_type": { "$ref": "common.schema.json#/$defs/ServiceTypeStr" },
          "label": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "not": { "pattern": "\n" } },
          "provider": { "$ref": "common.schema.json#/$defs/NamePin" },
          "transport_key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" }
        }
      }
    },
    "role_policies": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional preimages for on-chain link.<role>.p threshold pins. Zero authority unless SHA256(JCS(policy)) equals the confirmed on-chain link.<role>.p hash.",
      "properties": {
        "grant": { "$ref": "common.schema.json#/$defs/ThresholdPolicy" },
        "cred": { "$ref": "common.schema.json#/$defs/ThresholdPolicy" },
        "notary": { "$ref": "common.schema.json#/$defs/ThresholdPolicy" },
        "release": { "$ref": "common.schema.json#/$defs/ThresholdPolicy" }
      }
    },
    "notary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log"],
      "properties": {
        "policy_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
        "log": { "$ref": "#/$defs/LogBindingSpec" },
        "supported_claim_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9._-]+(/[a-z0-9._-]+)+$", "maxLength": 128, "not": { "pattern": "\n" } }
        },
        "supported_schemes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._/-]*$", "not": { "pattern": "\n" } }
        },
        "mirror_endpoints": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/MirrorEndpoint" }
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_product_prefixes"],
      "properties": {
        "allowed_product_prefixes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-z0-9._-]+(/[a-z0-9._-]+)*/$", "not": { "pattern": "\n" } }
        },
        "log": { "$ref": "#/$defs/LogBindingSpec" },
        "supported_schemes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-z0-9][a-z0-9._/-]*$", "not": { "pattern": "\n" } }
        },
        "mirror_endpoints": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/MirrorEndpoint" }
        }
      }
    }
  },
  "$defs": {
    "RoleTag": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "not": { "pattern": "\n" }
    },
    "TransportKind": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(https-tls-spki|nostr|matrix|xmpp|ssh|signal|email|telegram|[a-z0-9-]+(\\.[a-z0-9-]+)+/[a-z0-9][a-z0-9._-]{0,63})$",
      "not": { "pattern": "\n" }
    },
    "LogBindingSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["log_id", "genesis_seal", "heartbeat_max_blocks"],
      "properties": {
        "log_id": { "$ref": "common.schema.json#/$defs/Hex64" },
        "genesis_seal": { "$ref": "common.schema.json#/$defs/Seal" },
        "heartbeat_max_blocks": { "type": "integer", "minimum": 1, "maximum": 52560, "x-seallink-refusal": "WIRE_INTEGER" },
        "predecessor_logs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/Hex64" }
        }
      }
    },
    "MirrorEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "$ref": "common.schema.json#/$defs/HttpsUri" },
        "tls_spki_sha256": { "$ref": "common.schema.json#/$defs/Hex64" }
      }
    },
    "AuthSetHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "network", "owner", "seq", "merkle_root"],
      "description": "Manifest-pinned fixed-depth (256-leaf padded) size-hiding salted Merkle root committing to seallink-auth-entry/1 leaves (sets.auth).",
      "properties": {
        "type": { "const": "seallink-auth-set-head/1" },
        "network": { "$ref": "common.schema.json#/$defs/Network" },
        "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
        "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
        "merkle_root": { "$ref": "common.schema.json#/$defs/Hex64" }
      }
    },
    "AuthEntry": {
      "description": "Salted leaf entry inside sets.auth; domain-separated leaf digest = H_tag('seallink-auth-entry/1', JCS(entry)) = SHA256(SHA256(tag) || SHA256(tag) || JCS(entry)), committed as Merkle leaf H_tag('seallink-merkle-leaf/1', leaf_digest) inside a fixed 256-leaf padded tree.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "network", "owner", "salt", "label", "alg", "key", "seal"],
          "properties": {
            "type": { "const": "seallink-auth-entry/1" },
            "network": { "$ref": "common.schema.json#/$defs/Network" },
            "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
            "salt": { "$ref": "common.schema.json#/$defs/Hex64" },
            "label": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
            "alg": { "const": "bip340" },
            "key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" },
            "seal": { "$ref": "common.schema.json#/$defs/Seal" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "network", "owner", "salt", "label", "alg", "key", "seal"],
          "properties": {
            "type": { "const": "seallink-auth-entry/1" },
            "network": { "$ref": "common.schema.json#/$defs/Network" },
            "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
            "salt": { "$ref": "common.schema.json#/$defs/Hex64" },
            "label": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
            "alg": { "const": "p256" },
            "key": { "$ref": "common.schema.json#/$defs/P256Pubkey66" },
            "seal": { "$ref": "common.schema.json#/$defs/Seal" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "network", "owner", "salt", "label", "alg", "key", "seal"],
          "properties": {
            "type": { "const": "seallink-auth-entry/1" },
            "network": { "$ref": "common.schema.json#/$defs/Network" },
            "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
            "salt": { "$ref": "common.schema.json#/$defs/Hex64" },
            "label": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
            "alg": { "const": "ed25519" },
            "key": { "$ref": "common.schema.json#/$defs/Ed25519Pubkey64" },
            "seal": { "$ref": "common.schema.json#/$defs/Seal" }
          }
        }
      ]
    },
    "AuthEntryProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "entry", "proof"],
      "properties": {
        "head": { "$ref": "#/$defs/AuthSetHead" },
        "entry": { "$ref": "#/$defs/AuthEntry" },
        "proof": { "$ref": "common.schema.json#/$defs/SetEntryMerkleProof" }
      }
    },
    "DeviceSetHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "network", "owner", "seq", "merkle_root"],
      "description": "Manifest-pinned fixed-depth (256-leaf padded) size-hiding salted Merkle root committing to seallink-device-entry/1 leaves (sets.devices).",
      "properties": {
        "type": { "const": "seallink-device-set-head/1" },
        "network": { "$ref": "common.schema.json#/$defs/Network" },
        "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
        "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
        "merkle_root": { "$ref": "common.schema.json#/$defs/Hex64" }
      }
    },
    "DeviceEntry": {
      "description": "Salted leaf entry inside sets.devices; domain-separated leaf digest = H_tag('seallink-device-entry/1', JCS(entry)) = SHA256(SHA256(tag) || SHA256(tag) || JCS(entry)), committed as Merkle leaf H_tag('seallink-merkle-leaf/1', leaf_digest) inside a fixed 256-leaf padded tree.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "network", "owner", "salt", "label", "alg", "key", "presence", "ceiling", "seal"],
          "properties": {
            "type": { "const": "seallink-device-entry/1" },
            "network": { "$ref": "common.schema.json#/$defs/Network" },
            "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
            "salt": { "$ref": "common.schema.json#/$defs/Hex64" },
            "label": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
            "alg": { "const": "bip340" },
            "key": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" },
            "presence": { "type": "boolean" },
            "ceiling": { "type": "integer", "enum": [0, 1, 2] },
            "seal": { "$ref": "common.schema.json#/$defs/Seal" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "network", "owner", "salt", "label", "alg", "key", "presence", "ceiling", "seal"],
          "properties": {
            "type": { "const": "seallink-device-entry/1" },
            "network": { "$ref": "common.schema.json#/$defs/Network" },
            "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
            "salt": { "$ref": "common.schema.json#/$defs/Hex64" },
            "label": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
            "alg": { "const": "p256" },
            "key": { "$ref": "common.schema.json#/$defs/P256Pubkey66" },
            "presence": { "type": "boolean" },
            "ceiling": { "type": "integer", "enum": [0, 1, 2] },
            "seal": { "$ref": "common.schema.json#/$defs/Seal" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "network", "owner", "salt", "label", "alg", "key", "presence", "ceiling", "seal"],
          "properties": {
            "type": { "const": "seallink-device-entry/1" },
            "network": { "$ref": "common.schema.json#/$defs/Network" },
            "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
            "salt": { "$ref": "common.schema.json#/$defs/Hex64" },
            "label": { "type": "string", "minLength": 1, "maxLength": 64, "not": { "pattern": "\n" } },
            "alg": { "const": "ed25519" },
            "key": { "$ref": "common.schema.json#/$defs/Ed25519Pubkey64" },
            "presence": { "type": "boolean" },
            "ceiling": { "type": "integer", "enum": [0, 1, 2] },
            "seal": { "$ref": "common.schema.json#/$defs/Seal" }
          }
        }
      ]
    },
    "DeviceEntryProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "entry", "proof"],
      "properties": {
        "head": { "$ref": "#/$defs/DeviceSetHead" },
        "entry": { "$ref": "#/$defs/DeviceEntry" },
        "proof": { "$ref": "common.schema.json#/$defs/SetEntryMerkleProof" }
      }
    },
    "MembersList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "network", "owner", "seq", "entries"],
      "properties": {
        "type": { "const": "seallink-members-list/1" },
        "network": { "$ref": "common.schema.json#/$defs/Network" },
        "owner": { "$ref": "common.schema.json#/$defs/NameStr" },
        "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
        "entries": {
          "type": "array",
          "maxItems": 1024,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "registration", "owner_policy", "seal"],
            "properties": {
              "name": { "$ref": "common.schema.json#/$defs/NameStr" },
              "registration": { "$ref": "common.schema.json#/$defs/Outpoint" },
              "owner_policy": { "$ref": "common.schema.json#/$defs/ScriptPolicy" },
              "roles": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/RoleTag" }
              },
              "seal": { "$ref": "common.schema.json#/$defs/Seal" }
            }
          }
        }
      }
    },
    "CertSetHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "network", "issuer_name", "seq", "count", "set_sha256"],
      "description": "Manifest-pinned head committing set_sha256 = SHA256(JCS(sorted_statement_content_addrs[])) over the actor's complete active statement set.",
      "properties": {
        "type": { "const": "seallink-certset-head/1" },
        "network": { "$ref": "common.schema.json#/$defs/Network" },
        "issuer_name": { "$ref": "common.schema.json#/$defs/NameStr" },
        "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
        "count": { "$ref": "common.schema.json#/$defs/Uint53" },
        "set_sha256": { "$ref": "common.schema.json#/$defs/Hex64" }
      }
    },
    "IdentityLinkSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "peer"],
      "properties": {
        "relation": { "type": "string", "enum": ["same-controller", "member-of", "contact"] },
        "peer": { "$ref": "common.schema.json#/$defs/NamePin" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/RoleTag" }
        }
      },
      "allOf": [
        {
          "if": { "required": ["roles"] },
          "then": { "properties": { "relation": { "const": "member-of" } } }
        }
      ]
    },
    "Statement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["payload", "signatures"],
          "properties": {
            "payload": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "network", "genesis", "issuer", "statement_kind", "subject", "seq", "not_before", "not_after", "body_sha256"],
                  "properties": {
                    "type": { "const": "seallink-statement/1" },
                    "network": { "$ref": "common.schema.json#/$defs/Network" },
                    "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
                    "statement_kind": { "const": "config-section" },
                    "subject": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["host_id", "section"],
                      "properties": {
                        "host_id": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } },
                        "section": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } }
                      }
                    },
                    "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                    "not_before": { "$ref": "common.schema.json#/$defs/Uint53" },
                    "not_after": { "$ref": "common.schema.json#/$defs/Uint53" },
                    "body_sha256": { "$ref": "common.schema.json#/$defs/Hex64" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "network", "genesis", "issuer", "statement_kind", "subject", "seq", "not_before", "not_after"],
                  "properties": {
                    "type": { "const": "seallink-statement/1" },
                    "network": { "$ref": "common.schema.json#/$defs/Network" },
                    "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
                    "statement_kind": { "const": "transport-binding" },
                    "subject": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["transport", "endpoint", "key_alg", "key_hex"],
                          "properties": {
                            "transport": { "$ref": "#/$defs/TransportKind" },
                            "endpoint": { "type": "string", "minLength": 1, "maxLength": 512, "not": { "pattern": "\n" } },
                            "key_alg": { "const": "sha256-spki" },
                            "key_hex": { "$ref": "common.schema.json#/$defs/Hex64" }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["transport", "endpoint", "key_alg", "key_hex"],
                          "properties": {
                            "transport": { "$ref": "#/$defs/TransportKind" },
                            "endpoint": { "type": "string", "minLength": 1, "maxLength": 512, "not": { "pattern": "\n" } },
                            "key_alg": { "const": "bip340" },
                            "key_hex": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["transport", "endpoint", "key_alg", "key_hex"],
                          "properties": {
                            "transport": { "$ref": "#/$defs/TransportKind" },
                            "endpoint": { "type": "string", "minLength": 1, "maxLength": 512, "not": { "pattern": "\n" } },
                            "key_alg": { "const": "ed25519" },
                            "key_hex": { "$ref": "common.schema.json#/$defs/Ed25519Pubkey64" }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["transport", "endpoint", "key_alg", "key_hex"],
                          "properties": {
                            "transport": { "$ref": "#/$defs/TransportKind" },
                            "endpoint": { "type": "string", "minLength": 1, "maxLength": 512, "not": { "pattern": "\n" } },
                            "key_alg": { "const": "x25519" },
                            "key_hex": { "$ref": "common.schema.json#/$defs/X25519Pubkey64" }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["transport", "endpoint", "key_alg", "key_hex"],
                          "properties": {
                            "transport": { "$ref": "#/$defs/TransportKind" },
                            "endpoint": { "type": "string", "minLength": 1, "maxLength": 512, "not": { "pattern": "\n" } },
                            "key_alg": { "const": "p256" },
                            "key_hex": { "$ref": "common.schema.json#/$defs/P256Pubkey66" }
                          }
                        }
                      ]
                    },
                    "seal": { "$ref": "common.schema.json#/$defs/Seal" },
                    "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                    "not_before": { "$ref": "common.schema.json#/$defs/Uint53" },
                    "not_after": { "$ref": "common.schema.json#/$defs/Uint53" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "network", "genesis", "issuer", "statement_kind", "subject", "seq", "not_before", "not_after"],
                  "properties": {
                    "type": { "const": "seallink-statement/1" },
                    "network": { "$ref": "common.schema.json#/$defs/Network" },
                    "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
                    "statement_kind": { "const": "identity-link" },
                    "subject": { "$ref": "#/$defs/IdentityLinkSubject" },
                    "seal": { "$ref": "common.schema.json#/$defs/Seal" },
                    "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                    "not_before": { "$ref": "common.schema.json#/$defs/Uint53" },
                    "not_after": { "$ref": "common.schema.json#/$defs/Uint53" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "network", "genesis", "issuer", "statement_kind", "subject", "seq", "not_before", "not_after", "body_sha256"],
                  "properties": {
                    "type": { "const": "seallink-statement/1" },
                    "network": { "$ref": "common.schema.json#/$defs/Network" },
                    "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
                    "statement_kind": { "const": "profile-section" },
                    "subject": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["section_kind"],
                      "properties": {
                        "section_kind": {
                          "type": "string",
                          "minLength": 5,
                          "maxLength": 128,
                          "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+/[a-z0-9][a-z0-9._-]{0,63}$",
                          "not": { "pattern": "\n" }
                        },
                        "visibility": { "type": "string", "enum": ["public", "private"] }
                      }
                    },
                    "body_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "locators": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 8,
                      "uniqueItems": true,
                      "items": { "$ref": "common.schema.json#/$defs/LocatorUri" }
                    },
                    "seal": { "$ref": "common.schema.json#/$defs/Seal" },
                    "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                    "not_before": { "$ref": "common.schema.json#/$defs/Uint53" },
                    "not_after": { "$ref": "common.schema.json#/$defs/Uint53" }
                  },
                  "allOf": [
                    {
                      "if": {
                        "required": ["subject"],
                        "properties": {
                          "subject": {
                            "required": ["visibility"],
                            "properties": { "visibility": { "const": "private" } }
                          }
                        }
                      },
                      "then": { "not": { "required": ["locators"] } }
                    }
                  ]
                }
              ]
            },
            "signatures": { "$ref": "common.schema.json#/$defs/DeviceSignatureSet" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["payload", "signatures"],
          "description": "Privileged BIP-340-only statements (root-rotate, root-cancel, migration-accept, migration-fence); device keys are strictly forbidden.",
          "properties": {
            "payload": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "network", "genesis", "issuer", "statement_kind", "subject", "seq", "not_before", "not_after"],
                  "properties": {
                    "type": { "const": "seallink-statement/1" },
                    "network": { "$ref": "common.schema.json#/$defs/Network" },
                    "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
                    "statement_kind": { "const": "root-rotate" },
                    "subject": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["host_id", "new_role_policy"],
                      "properties": {
                        "host_id": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } },
                        "new_role_policy": { "$ref": "common.schema.json#/$defs/ThresholdPolicy" }
                      }
                    },
                    "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                    "not_before": { "$ref": "common.schema.json#/$defs/Uint53" },
                    "not_after": { "$ref": "common.schema.json#/$defs/Uint53" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "network", "genesis", "issuer", "statement_kind", "subject", "seq", "not_before", "not_after"],
                  "properties": {
                    "type": { "const": "seallink-statement/1" },
                    "network": { "$ref": "common.schema.json#/$defs/Network" },
                    "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
                    "statement_kind": { "const": "root-cancel" },
                    "subject": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["host_id", "override_id"],
                      "properties": {
                        "host_id": { "type": "string", "minLength": 1, "maxLength": 128, "not": { "pattern": "\n" } },
                        "override_id": { "$ref": "common.schema.json#/$defs/Hex64" }
                      }
                    },
                    "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                    "not_before": { "$ref": "common.schema.json#/$defs/Uint53" },
                    "not_after": { "$ref": "common.schema.json#/$defs/Uint53" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "network", "genesis", "issuer", "statement_kind", "subject", "seq", "not_before", "not_after"],
                  "properties": {
                    "type": { "const": "seallink-statement/1" },
                    "network": { "$ref": "common.schema.json#/$defs/Network" },
                    "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
                    "statement_kind": { "const": "migration-accept" },
                    "subject": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["migration_id", "holder", "source_executor", "inventory_sha256"],
                      "properties": {
                        "migration_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                        "holder": { "$ref": "common.schema.json#/$defs/NamePin" },
                        "source_executor": { "$ref": "common.schema.json#/$defs/NamePin" },
                        "inventory_sha256": { "$ref": "common.schema.json#/$defs/Hex64" }
                      }
                    },
                    "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                    "not_before": { "$ref": "common.schema.json#/$defs/Uint53" },
                    "not_after": { "$ref": "common.schema.json#/$defs/Uint53" }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "network", "genesis", "issuer", "statement_kind", "subject", "seq", "not_before", "not_after"],
                  "properties": {
                    "type": { "const": "seallink-statement/1" },
                    "network": { "$ref": "common.schema.json#/$defs/Network" },
                    "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                    "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
                    "statement_kind": { "const": "migration-fence" },
                    "subject": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["migration_id", "holder", "dest_executor", "source_journal_pos", "source_journal_commitment", "inventory_sha256", "predecessor_grant_seals"],
                      "properties": {
                        "migration_id": { "$ref": "common.schema.json#/$defs/Hex64" },
                        "holder": { "$ref": "common.schema.json#/$defs/NamePin" },
                        "dest_executor": { "$ref": "common.schema.json#/$defs/NamePin" },
                        "source_journal_pos": { "$ref": "common.schema.json#/$defs/Uint53" },
                        "source_journal_commitment": { "$ref": "common.schema.json#/$defs/Hex64" },
                        "inventory_sha256": { "$ref": "common.schema.json#/$defs/Hex64" },
                        "predecessor_grant_seals": {
                          "type": "array",
                          "maxItems": 256,
                          "items": { "$ref": "common.schema.json#/$defs/Seal" }
                        }
                      }
                    },
                    "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                    "not_before": { "$ref": "common.schema.json#/$defs/Uint53" },
                    "not_after": { "$ref": "common.schema.json#/$defs/Uint53" }
                  }
                }
              ]
            },
            "signatures": { "$ref": "common.schema.json#/$defs/SignatureSet" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["payload", "guardian_approvals"],
          "properties": {
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "network", "genesis", "issuer", "statement_kind", "subject", "guardian_context", "seq", "not_before", "not_after"],
              "properties": {
                "type": { "const": "seallink-statement/1" },
                "network": { "$ref": "common.schema.json#/$defs/Network" },
                "genesis": { "$ref": "common.schema.json#/$defs/Hex64" },
                "issuer": { "$ref": "common.schema.json#/$defs/NamePin" },
                "statement_kind": { "const": "identity-link" },
                "subject": { "$ref": "#/$defs/IdentityLinkSubject" },
                "guardian_context": { "$ref": "common.schema.json#/$defs/GuardianContext" },
                "seal": { "$ref": "common.schema.json#/$defs/Seal" },
                "seq": { "$ref": "common.schema.json#/$defs/PositiveUint53" },
                "not_before": { "$ref": "common.schema.json#/$defs/Uint53" },
                "not_after": { "$ref": "common.schema.json#/$defs/Uint53" }
              }
            },
            "guardian_approvals": { "$ref": "common.schema.json#/$defs/GuardianApprovals" }
          }
        }
      ]
    }
  }
}
