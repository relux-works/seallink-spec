{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seallink.org/releases/v1.0.0-draft.11/schemas/name-value.schema.json",
  "title": "SealLink v1.0 Ledger Name Value (520-Byte Budget)",
  "description": "Formal schema for SealLink-recognized top-level members in a Namecoin name value. Unknown owner-defined top-level members are permitted and ignored by SealLink readers (SL-IDEN-002), while all 71 Unicode simple case-fold aliases of link, m, and nostr are explicitly forbidden (WIRE_DUPLICATE).",
  "type": "object",
  "additionalProperties": true,
  "propertyNames": {
    "not": {
      "enum": [
        "LINK", "LINk", "LIN\u212a", "LInK", "LInk", "LIn\u212a", "LiNK", "LiNk", "LiN\u212a", "LinK", "Link", "Lin\u212a",
        "M",
        "NOSTR", "NOSTr", "NOStR", "NOStr", "NOsTR", "NOsTr", "NOstR", "NOstr", "NO\u017fTR", "NO\u017fTr", "NO\u017ftR", "NO\u017ftr",
        "NoSTR", "NoSTr", "NoStR", "NoStr", "NosTR", "NosTr", "NostR", "Nostr", "No\u017fTR", "No\u017fTr", "No\u017ftR", "No\u017ftr",
        "lINK", "lINk", "lIN\u212a", "lInK", "lInk", "lIn\u212a", "liNK", "liNk", "liN\u212a", "linK", "lin\u212a",
        "nOSTR", "nOSTr", "nOStR", "nOStr", "nOsTR", "nOsTr", "nOstR", "nOstr", "nO\u017fTR", "nO\u017fTr", "nO\u017ftR", "nO\u017ftr",
        "noSTR", "noSTr", "noStR", "noStr", "nosTR", "nosTr", "nostR", "no\u017fTR", "no\u017fTr", "no\u017ftR", "no\u017ftr"
      ]
    },
    "x-seallink-refusal": "WIRE_DUPLICATE"
  },
  "properties": {
    "link": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "grant": { "$ref": "#/$defs/RoleKeyOrPolicyPin" },
        "cred": { "$ref": "#/$defs/RoleKeyOrPolicyPin" },
        "notary": { "$ref": "#/$defs/RoleKeyOrPolicyPin" },
        "release": { "$ref": "#/$defs/RoleKeyOrPolicyPin" },
        "origin": { "$ref": "common.schema.json#/$defs/Hex64" }
      }
    },
    "m": {
      "type": "object",
      "additionalProperties": false,
      "required": ["h", "s"],
      "properties": {
        "h": { "$ref": "common.schema.json#/$defs/Hex64" },
        "s": { "$ref": "common.schema.json#/$defs/PositiveUint53" }
      }
    },
    "nostr": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["names"],
          "properties": {
            "names": {
              "type": "object",
              "required": ["_"],
              "properties": {
                "_": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" }
              },
              "additionalProperties": { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" }
            },
            "relays": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "maxItems": 16,
                "items": { "$ref": "common.schema.json#/$defs/RelayUri" }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "RoleKeyOrPolicyPin": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/XOnlyPubkey64" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["p"],
          "properties": {
            "p": {
              "$ref": "common.schema.json#/$defs/Hex64",
              "description": "SHA-256 of canonical JCS ThresholdPolicy (BIP-340 m-of-n, alg omitted). Any change to the role policy requires an owner-authored ledger update."
            }
          }
        }
      ]
    }
  }
}
