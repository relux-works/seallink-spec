      "target_authority": "mailbox_owner",
      "external_mutation": true,
      "allows_executor_ref": false,
      "allows_bearer_session": true,
      "requires_contract": false,
      "require_seal": true,
      "risk_class": 1,
      "mechanical": true,
      "quota_consuming": true,
      "required_quotas": [
        {
          "kind": "seallink/count",
          "resource": "{target}",
          "unit": "messages"
        }
      ],
      "allowed_where_predicates": {
        "to": ["eq", "in", "not_in", "suffix"],
        "subject": ["eq", "prefix"],
        "body_sha256": ["hash_eq"],
        "size_bytes": ["range"]
      },
      "guardian_event_class": "effect_grant"
    },
    {
      "action": "agent/brief",
      "service_type": "agent-session",
      "profile": "profiles/PROFILE-agent-v1.md",
