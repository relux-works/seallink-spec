      "result_schema": "schemas/profile-agent.schema.json#/$defs/AgentSessionResult",
      "target_pattern": "^station:([a-z0-9][a-z0-9./_-]{0,254}):([a-z0-9][a-z0-9._-]{0,63})$",
      "target_authority": "station_host",
      "external_mutation": true,
      "allows_executor_ref": false,
      "allows_bearer_session": true,
      "requires_contract": true,
      "require_seal": true,
      "risk_class": 1,
      "mechanical": true,
      "quota_consuming": true,
      "required_quotas": [
        {
          "kind": "seallink/count",
