          "kind": "seallink/count",
          "resource": "{target}",
          "unit": "calls"
        }
      ],
      "allowed_where_predicates": {
        "tool_name": ["eq", "in", "not_in"],
        "input_sha256": ["hash_eq"],
        "resource_path": ["eq", "in", "not_in", "prefix"],
        "max_output_bytes": ["range"],
        "max_tokens": ["range"],
        "max_cost": ["range"]
      },
