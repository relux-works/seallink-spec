{
  "$comment": "SealLink v1.0 Authoritative Action Profile Registry (SPEC-06, SPEC-07, PROFILE-mail-v1, PROFILE-agent-v1). Machine-readable SSOT for action argument/result schemas, target authority rules, mandatory quotas, allowed where-predicates, and guardian event classes. Executors MUST refuse unregistered actions unless explicitly enabled via a local SLIP profile.",
  "protocol": "SealLink",
  "version": "1.0.0-draft.12",
  "actions": [
    {
      "action": "mail/list",
      "service_type": "mail",
      "profile": "profiles/PROFILE-mail-v1.md",
      "args_schema": "schemas/profile-mail.schema.json#/$defs/MailListArgs",
      "result_schema": "schemas/profile-mail.schema.json#/$defs/MailListResult",
      "target_pattern": "^mailbox:([a-z0-9][a-z0-9./_-]{0,254}):([a-z0-9][a-z0-9._-]{0,63})$",
      "target_authority": "mailbox_owner",
      "external_mutation": false,
      "allows_executor_ref": true,
      "allows_bearer_session": true,
      "requires_contract": false,
      "require_seal": true,
      "risk_class": 2,
      "mechanical": true,
      "quota_consuming": false,
      "required_quotas": [],
      "allowed_where_predicates": {
        "folder": ["eq", "in", "not_in", "prefix"],
        "sender_domain": ["eq", "in", "not_in", "suffix"],
        "max_bytes": ["range"]
      },
      "guardian_event_class": "routine_read"
    },
    {
      "action": "mail/read",
      "service_type": "mail",
      "profile": "profiles/PROFILE-mail-v1.md",
      "args_schema": "schemas/profile-mail.schema.json#/$defs/MailReadArgs",
