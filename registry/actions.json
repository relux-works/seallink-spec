    {
      "action": "agent/guardian-message",
      "service_type": "agent-session",
      "profile": "profiles/PROFILE-agent-v1.md",
      "args_schema": "schemas/profile-agent.schema.json#/$defs/AgentGuardianMessageArgs",
      "result_schema": "schemas/profile-agent.schema.json#/$defs/AgentGuardianMessageResult",
