      "allows_executor_ref": false,
      "allows_bearer_session": false,
      "requires_contract": false,
      "require_seal": true,
      "risk_class": 1,
      "mechanical": true,
      "quota_consuming": false,
      "required_quotas": [],
      "allowed_where_predicates": {
        "origin_id": ["eq"],
